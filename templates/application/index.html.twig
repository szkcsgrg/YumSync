        window.createHousehold = async function() {
            const name = document.getElementById('newHouseholdName').value.trim();
            
            if (!name) {
                window.showAlert('Please enter a household name', 'warning');
                return;
            }

            window.setCreateLoadingState(true);
            
            try {
                const response = await fetch('/api/household/create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name: name })
                });

                const result = await response.json();
                
                if (result.success) {
                    window.showAlert(`Household "${name}" created successfully! Share ID: ${result.household.id}`, 'success');
                    window.currentHousehold = result.household;
                    window.hideCreateForm();
                    window.showCurrentHousehold(result.household);
                    
                    // Copy ID to clipboard
                    window.copyToClipboard(result.household.id.toString());
                } else {
                    window.showAlert(result.error || 'Failed to create household', 'danger');
                }
            } catch (error) {
                console.error('Error creating household:', error);
                window.showAlert('Network error. Please try again.', 'danger');
            } finally {
                window.setCreateLoadingState(false);
            }
        };

        window.requestJoinHousehold = async function() {
            const householdId = document.getElementById('householdIdInput').value.trim();
            
            if (!householdId || householdId.length !== 6) {
                window.showAlert('Please enter a valid 6-digit household ID', 'warning');
                return;
            }

            window.setJoinLoadingState(true);
            
            try {
                const response = await fetch('/api/household/join-request', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ householdId: parseInt(householdId) })
                });

                const result = await response.json();
                
                if (result.success) {
                    window.showAlert(`Join request sent to "${result.household.name}"! Wait for approval.`, 'success');
                    window.hideJoinForm();
                    
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('householdModal'));
                    modal.hide();
                } else {
                    window.showAlert(result.error || 'Failed to send join request', 'danger');
                }
            } catch (error) {
                console.error('Error sending join request:', error);
                window.showAlert('Network error. Please try again.', 'danger');
            } finally {
                window.setJoinLoadingState(false);
            }
        };

