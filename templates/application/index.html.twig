        // Load household members (for owners)
        window.loadHouseholdMembers = async function() {
            if (!window.currentHousehold || window.currentHousehold.role !== 'owner') return;
            
            try {
                const timestamp = Date.now();
                const response = await fetch(`/api/household/members?_t=${timestamp}`);
                const result = await response.json();
                
                if (result.success) {
                    window.showHouseholdMembers(result.members);
                } else {
                    throw new Error(result.message || 'Failed to load members');
                }
            } catch (error) {
                console.error('Error loading household members:', error);
                document.getElementById('membersList').innerHTML = 
                    '<div class="alert alert-danger">Error loading members. Please try again.</div>';
            }
        };

