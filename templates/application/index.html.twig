{% extends 'base.html.twig' %}

{% block title %}YumSync Application{% endblock %}

{% block body %}

    {% include 'components/applicationHeader.html.twig' with {'userHouseholdRole': userHouseholdRole} %}

    <div class="container-fluid container-lg mt-4">
        <div class="row">
            <div class="col-md-12">
                <p><strong>Welcome:</strong> {{ name }} ({{ email }})</p>

                {% if requiresHousehold is defined and requiresHousehold %}
                    <!-- Household Required Message -->
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading"><i class="fas fa-home me-2"></i>Household Required</h4>
                        <p>{{ message }}</p>
                        <hr>
                        <p class="mb-0">
                            <strong>Options:</strong>
                            <br>• Create your own household and invite family members
                            <br>• Ask a family member to invite you to their existing household
                        </p>
                    </div>
                    
                    <div class="text-center">
                        <p class="text-muted">Once you're part of a household, you'll be able to manage shopping lists and collaborate with your family members.</p>
                    </div>
                {% else %}
                    <!-- Normal Application Content -->

                <!-- Product Input Section -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Add New Product</h5>
                        <div class="d-flex justify-content-center align-items-center gap-1">
                            <input type="text" class="form-control" id="productInput" placeholder="Enter product name">
                            <button class="btn btn-primary text-nowrap" type="button" id="addProductButton" data-bs-toggle="modal" data-bs-target="#productModal">
                                Add Product
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Shopping Lists Section - Grouped by Shop -->
                <div class="row" id="shopListsContainer">
                    {% if shoppingLists %}
                        {% for shopList in shoppingLists %}
                            <div class="col-12 col-lg-6 col-xl-4 mb-4 shop-card-container" 
                                 data-shop-id="{{ shopList.shop.shopId }}"
                                 data-shop-name="{{ shopList.shop.name }}">
                                <div class="card shop-card">
                                    <!-- Unified Header - Mobile/Desktop -->
                                    <div class="card-header mobile-header" 
                                         data-bs-toggle="collapse" 
                                         data-bs-target="#collapse-{{ shopList.shop.shopId }}" 
                                         aria-expanded="false" 
                                         aria-controls="collapse-{{ shopList.shop.shopId }}">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">
                                                <i class="fas fa-grip-vertical text-muted me-2 drag-handle d-none d-lg-inline"></i>
                                                {{ shopList.shop.name }}
                                                <span class="badge bg-secondary ms-2">{{ shopList.items|length }} items</span>
                                            </h5>
                                            <i class="fas fa-chevron-down collapse-icon d-lg-none"></i>
                                        </div>
                                    </div>
                                    
                                    <!-- Collapsible Card Body -->
                                    <div class="collapse d-lg-block" id="collapse-{{ shopList.shop.shopId }}">
                                        <div class="card-body">
                                        <!-- Unpurchased Items -->
                                        {% if shopList.items %}
                                            <ul class="list-group list-group-flush draggable-list" 
                                                id="shoppingList-{{ shopList.shop.shopId }}" 
                                                data-shop-id="{{ shopList.shop.shopId }}"
                                                data-shop-name="{{ shopList.shop.name }}">
                                                {% for item in shopList.items %}
                                                    <li class="list-group-item d-flex justify-content-between align-items-center draggable-item" 
                                                        data-item-id="{{ item.id }}"
                                                        data-item-name="{{ item.label }}"
                                                        data-item-quantity="{{ item.quantity }}"
                                                        data-item-shop-id="{{ shopList.shop.shopId }}"
                                                        data-purchased="false"
                                                        draggable="true">
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-grip-vertical d-none d-lg-block text-muted me-2"></i>
                                                            <span>{{ item.label }}</span>
                                                        </div>
                                                        <div>
                                                            <span class="badge bg-primary rounded-pill me-2">{{ item.quantity }}</span>
                                                            <button class="btn btn-sm btn-outline-secondary me-1 edit-item-btn" 
                                                                    data-item-id="{{ item.id }}"
                                                                    data-item-name="{{ item.label }}"
                                                                    data-item-quantity="{{ item.quantity }}"
                                                                    data-item-shop-id="{{ shopList.shop.shopId }}"
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#productModal"
                                                                    title="Edit item">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-success mark-purchased-btn" 
                                                                    data-item-id="{{ item.id }}" 
                                                                    title="Mark as purchased">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        </div>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                        <!--
                                            <div class="text-center text-muted py-3 empty-state">
                                                <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                                                <p>No items in this shop's list yet.</p>
                                            </div>
                                            -->
                                            <!-- Always visible draggable list for empty shops -->
                                            <ul class="list-group list-group-flush draggable-list" 
                                                id="shoppingList-{{ shopList.shop.shopId }}" 
                                                data-shop-id="{{ shopList.shop.shopId }}"
                                                data-shop-name="{{ shopList.shop.name }}">
                                            </ul>
                                        {% endif %}

                                        <!-- Purchased Items Section - Show when there are items in main list OR purchased items -->
                                        {% if shopList.items or shopList.purchasedItems %}
                                            <hr class="my-3">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h6 class="text-muted mb-0">
                                                    <i class="fas fa-check-circle me-1"></i>Purchased Items ({{ shopList.purchasedItems|length }})
                                                </h6>
                                                {% if shopList.purchasedItems %}
                                                    <div class="btn-group gap-2" role="group">
                                                        <button class="btn btn-sm btn-outline-success revert-all-btn" 
                                                                data-shop-id="{{ shopList.shop.shopId }}"
                                                                title="Move all purchased items back to shopping list">
                                                            <i class="fas fa-undo me-1"></i>Revert All
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger delete-purchased-btn" 
                                                                data-shop-id="{{ shopList.shop.shopId }}"
                                                                title="Delete all purchased items for this shop">
                                                            <i class="fas fa-trash me-1"></i>Clear All
                                                        </button>
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <ul class="list-group list-group-flush draggable-list" 
                                                data-shop-id="{{ shopList.shop.shopId }}"
                                                data-shop-name="{{ shopList.shop.name }}"
                                                data-purchased-section="true">
                                                {% for item in shopList.purchasedItems %}
                                                    <li class="list-group-item d-flex justify-content-between align-items-center text-muted purchased-item-clickable draggable-item" 
                                                        data-item-id="{{ item.id }}" 
                                                        data-item-name="{{ item.label }}"
                                                        data-item-quantity="{{ item.quantity }}"
                                                        data-item-shop-id="{{ shopList.shop.shopId }}"
                                                        data-purchased="true"
                                                        title="Click to mark as unpurchased"
                                                        draggable="true">
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-grip-vertical text-muted me-2"></i>
                                                            <span>{{ item.label }}</span>
                                                        </div>
                                                        <div>
                                                            <span class="badge bg-secondary rounded-pill">{{ item.quantity }}</span>
                                                        </div>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="fas fa-info-circle fa-2x text-info mb-3"></i>
                                    <h5>No shops found</h5>
                                    <p class="text-muted">You need to set up shops first to start creating shopping lists.</p>
                                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#shopSetupModal">
                                        Setup Shops
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Modal for Product Details -->
    <div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productModalLabel">Add Product to List</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex justify-content-center align-items-center flex-column">
                    <!-- Hidden field to store item ID for editing -->
                    <input type="hidden" id="editItemId" value="">
                    
                    <!-- Product Name Input -->
                    <div class="col-12 col-md-10 mb-3">
                        <label for="newProductName" class="form-label">Product Name</label>
                        <input type="text" class="form-control" id="newProductName" placeholder="Enter product name">
                    </div>
                    
                    <!-- Amount Controls -->
                    <div class="col-12 col-md-10 mb-3">
                        <label class="form-label">Quantity</label>
                        <div class="input-group input-group-lg d-flex justify-content-center gap-3" style="height: 80px;">
                            <button class="btn btn-outline-secondary col-3 fs-3" type="button" id="decreaseAmountButton" style="height: 80px; line-height: 1;">-</button>
                            <input type="text" class="form-control text-center fs-2 fw-bold" id="productAmount" value="1" style="height: 80px; line-height: 80px;">
                            <button class="btn btn-outline-secondary col-3 fs-3" type="button" id="increaseAmountButton" style="height: 80px; line-height: 1;">+</button>
                        </div>
                    </div>

                    <!-- Shop Selection -->
                    <div class="col-12 col-md-10 mb-3">
                        <label for="shopSelect" class="form-label">Choose Shop</label>
                        <select class="form-select" id="shopSelect">
                            <option value="">Select a shop...</option>
                            {% for shop in userShops %}
                                <option value="{{ shop.shopId }}">{{ shop.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="me-auto">
                        <button type="button" class="btn btn-danger d-none" id="deleteProductButton">
                            <i class="fas fa-trash me-1"></i>Delete Product
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="assignProductButton">
                            <span id="addButtonText">Add to List</span>
                            <span id="addButtonSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Shop Setup Modal -->
    <div class="modal fade" id="shopSetupModal" tabindex="-1" aria-labelledby="shopSetupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="shopSetupModalLabel">Setup Your Shops</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 mb-4">
                            <h6><i class="fas fa-store me-2"></i>Add Your Preferred Shops</h6>
                            <p class="text-muted">Add the shops where you usually do your grocery shopping. These will become your shopping lists.</p>
                        </div>
                    </div>
                    
                    <!-- Shop Input Form -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="row align-items-end">
                                        <div class="col-md-8 mb-3">
                                            <label for="newShopName" class="form-label">Shop Name</label>
                                            <input type="text" class="form-control" id="newShopName" placeholder="Enter shop name (e.g., Walmart, Target, etc.)">
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <button class="btn btn-primary w-100" onclick="addShopToList()">
                                                <i class="fas fa-plus me-1"></i>Add Shop
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current Shops List -->
                    <div class="row">
                        <div class="col-12">
                            <h6>Your Shops:</h6>
                            <div id="shopsList" class="border rounded p-3" style="background-color: var(--bg-secondary);">
                                <div id="noShopsMessage" class="text-center text-muted py-3">
                                    <i class="fas fa-store fa-2x mb-2"></i>
                                    <p class="mb-0">No shops added yet. Add your first shop above!</p>
                                </div>
                                <div id="shopsContainer" class="d-none">
                                    <!-- Shops will be added here dynamically -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Location Settings -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Location Settings</h6>
                                <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleLocationSettings()">
                                    <i class="fas fa-cog"></i> <small>Adjust</small>
                                </button>
                            </div>
                            <div id="locationInfo" class="small text-muted mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                <span id="currentLocation">Detecting location...</span>
                            </div>
                            <div id="locationSettingsForm" class="d-none">
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <input type="text" class="form-control form-control-sm" id="countryCodeInput" placeholder="Country Code (e.g., HU)" maxlength="2">
                                    </div>
                                    <div class="col-md-4">
                                        <input type="text" class="form-control form-control-sm" id="countryInput" placeholder="Country">
                                    </div>
                                    <div class="col-md-4">
                                        <input type="text" class="form-control form-control-sm" id="regionInput" placeholder="Region/State">
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-success btn-sm" onclick="saveLocationSettings()">
                                        <i class="fas fa-save me-1"></i>Save Location
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="toggleLocationSettings()">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="me-auto">
                        <button type="button" class="btn btn-outline-secondary" onclick="addSampleShops()" id="addSampleShopsBtn">
                            <i class="fas fa-magic me-1"></i>Add Regional Shops
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-success" onclick="saveShops()" id="saveShopsBtn">
                            <span id="saveShopsText">Save Shops</span>
                            <span id="saveShopsSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

                {% endif %}
            </div>
        </div>
    </div>

    <!-- Household Management Modal -->
    <div class="modal fade" id="householdModal" tabindex="-1" aria-labelledby="householdModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="householdModalLabel">Household Management</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Current Household Display -->
                    <div id="currentHouseholdSection" class="d-none mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-home me-2"></i>Your Household
                                </h6>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong id="currentHouseholdName"></strong>
                                        <br>
                                        <small class="text-muted">
                                            ID: <span id="currentHouseholdId"></span> 
                                            <button class="btn btn-sm btn-outline-secondary ms-1" onclick="copyHouseholdId()" title="Copy ID">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                        </small>
                                        <br>
                                        <small class="text-muted">Role: <span id="currentHouseholdRole"></span></small>
                                    </div>
                                    <div id="leaveHouseholdButtonContainer" class="d-none">
                                        <button class="btn btn-sm btn-outline-danger" onclick="leaveHousehold()" title="Leave Household">
                                            <i class="fas fa-sign-out-alt me-1"></i>Leave
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Member Management Section (for owners) -->
                    <div id="memberManagementSection" class="d-none mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-users me-2"></i>Household Members
                                </h6>
                                <div id="membersList">
                                    <!-- Members will be loaded here -->
                                </div>
                                <button class="btn btn-sm btn-outline-primary mt-2" onclick="loadHouseholdMembers()">
                                    <i class="fas fa-sync-alt me-1"></i>Refresh Members
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Pending Requests Section (for owners) -->
                    <div id="pendingRequestsSection" class="d-none mb-4">
                        <h6><i class="fas fa-clock me-2"></i>Pending Join Requests</h6>
                        <div id="pendingRequestsList"></div>
                    </div>

                    <!-- Danger Zone - Delete Household (for owners only) -->
                    <div id="deleteHouseholdSection" class="d-none mb-4">
                        <div class="card border-danger">
                            <div class="card-header bg-danger text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Danger Zone
                                </h6>
                            </div>
                            <div class="card-body">
                                <h6 class="text-danger">Delete Household</h6>
                                <p class="text-muted small mb-3">
                                    <strong>Warning:</strong> This action cannot be undone. Deleting your household will:
                                </p>
                                <ul class="text-muted small mb-3">
                                    <li>Remove all shopping lists and items</li>
                                    <li>Remove all household members</li>
                                    <li>Delete the household permanently</li>
                                </ul>
                                <button class="btn btn-danger btn-sm" onclick="confirmDeleteHousehold()">
                                    <i class="fas fa-trash me-1"></i>Delete Household
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Create/Join Options -->
                    <div id="householdOptionsSection">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-plus-circle fa-3x text-primary mb-3"></i>
                                        <h6>Create New Household</h6>
                                        <p class="text-muted small">Start a new household and invite family members</p>
                                        <button class="btn btn-primary" onclick="showCreateForm()">Create Household</button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-sign-in-alt fa-3x text-success mb-3"></i>
                                        <h6>Join Existing Household</h6>
                                        <p class="text-muted small">Enter a household ID to request to join</p>
                                        <button class="btn btn-success" onclick="showJoinForm()">Join Household</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Create Household Form -->
                    <div id="createHouseholdForm" class="d-none">
                        <div class="card">
                            <div class="card-body">
                                <h6><i class="fas fa-home me-2"></i>Create New Household</h6>
                                <div class="mb-3">
                                    <label for="newHouseholdName" class="form-label">Household Name</label>
                                    <input type="text" class="form-control" id="newHouseholdName" placeholder="Enter household name (e.g., Smith Family)">
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary" onclick="createHousehold()">
                                        <span id="createButtonText">Create Household</span>
                                        <span id="createButtonSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                                    </button>
                                    <button class="btn btn-secondary" onclick="hideCreateForm()">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Join Household Form -->
                    <div id="joinHouseholdForm" class="d-none">
                        <div class="card">
                            <div class="card-body">
                                <h6><i class="fas fa-sign-in-alt me-2"></i>Join Existing Household</h6>
                                <div class="mb-3">
                                    <label for="householdIdInput" class="form-label">Household ID</label>
                                    <input type="text" class="form-control" id="householdIdInput" placeholder="Enter 6-digit household ID">
                                    <div class="form-text">Ask the household owner for their household ID</div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success" onclick="requestJoinHousehold()">
                                        <span id="joinButtonText">Send Join Request</span>
                                        <span id="joinButtonSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                                    </button>
                                    <button class="btn btn-secondary" onclick="hideJoinForm()">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile Management Modal -->
    <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="profileModalLabel">Account Settings</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Account Information -->
                    <div class="mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-user me-2"></i>Account Information
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Name:</strong> {{ name }}
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Email:</strong> {{ email }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Danger Zone - Delete Profile -->
                    <div class="mb-4">
                        <div class="card border-danger">
                            <div class="card-header bg-danger text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Danger Zone
                                </h6>
                            </div>
                            <div class="card-body">
                                <h6 class="text-danger">Delete Account</h6>
                                <p class="text-muted small mb-3">
                                    <strong>Warning:</strong> This action cannot be undone. Deleting your account will:
                                </p>
                                <ul class="text-muted small mb-3">
                                    <li>Delete all your shopping lists and items</li>
                                    <li>Delete all shops you created</li>
                                    <li>Remove you from all households</li>
                                    <li>Delete any households you own (including all members and data)</li>
                                    <li>Permanently delete your account</li>
                                </ul>
                                <button class="btn btn-danger btn-sm" onclick="confirmDeleteProfile()">
                                    <i class="fas fa-user-times me-1"></i>Delete My Account
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include 'components/footer.html.twig' %}
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // JavaScript for handling modal interactions and API calls
        document.addEventListener('DOMContentLoaded', function() {
            const productInput = document.getElementById('productInput');
            const newProductName = document.getElementById('newProductName');
            const productAmount = document.getElementById('productAmount');
            const decreaseBtn = document.getElementById('decreaseAmountButton');
            const increaseBtn = document.getElementById('increaseAmountButton');
            const addProductBtn = document.getElementById('addProductButton');
            const assignProductBtn = document.getElementById('assignProductButton');
            const shopSelect = document.getElementById('shopSelect');
            const addButtonText = document.getElementById('addButtonText');
            const addButtonSpinner = document.getElementById('addButtonSpinner');
            const editItemId = document.getElementById('editItemId');
            const modalTitle = document.getElementById('productModalLabel');
            const deleteProductBtn = document.getElementById('deleteProductButton');

            let isEditMode = false;

            // =========================
            // INITIALIZE DRAG AND DROP
            // =========================
            
            // Initialize drag and drop functionality for the application
            initializeDragAndDrop();
            
            // =========================
            // HOUSEHOLD MANAGEMENT
            // =========================
            
            // Global household data
            let currentHousehold = null;

            // Initialize household management
            async function initializeHousehold() {
                await window.loadCurrentHousehold();
                await window.loadPendingRequests();
            }

            // Load current household info
            window.loadCurrentHousehold = async function() {
                try {
                    const timestamp = Date.now();
                    const response = await fetch(`/api/household/my-household?_t=${timestamp}`);
                    const result = await response.json();
                    
                    if (result.success && result.household) {
                        window.currentHousehold = result.household;
                        window.showCurrentHousehold(result.household);
                    } else {
                        window.showHouseholdOptions();
                    }
                } catch (error) {
                    console.error('Error loading household:', error);
                    window.showHouseholdOptions();
                }
            };

            // Show household creation/join options
            window.showHouseholdOptions = function() {
                document.getElementById('currentHouseholdSection').classList.add('d-none');
                document.getElementById('householdOptionsSection').classList.remove('d-none');
                document.getElementById('pendingRequestsSection').classList.add('d-none');
            };

            // Add household button click listener
            document.getElementById('housholdMembersButton').addEventListener('click', function() {
                const modal = new bootstrap.Modal(document.getElementById('householdModal'));
                modal.show();
                
                // Reload household data when modal opens
                initializeHousehold();
            });

            // =========================
            // MOBILE COLLAPSE STATE MANAGEMENT
            // =========================
            
            // Function to save which shop lists are currently open
            function saveCollapseState() {
                const openShops = [];
                document.querySelectorAll('.collapse.show').forEach(collapse => {
                    const shopId = collapse.id.replace('collapse-', '');
                    openShops.push(shopId);
                });
                localStorage.setItem('yumsync_open_shops', JSON.stringify(openShops));
                console.log('Saved open shops:', openShops);
            }

            // Function to restore previously opened shop lists
            function restoreCollapseState() {
                const savedShops = localStorage.getItem('yumsync_open_shops');
                let openShops = [];
                
                if (savedShops) {
                    try {
                        openShops = JSON.parse(savedShops);
                        console.log('Found saved open shops:', openShops);
                    } catch (error) {
                        console.error('Error parsing saved collapse state:', error);
                        localStorage.removeItem('yumsync_open_shops');
                    }
                }
                
                // Auto-open shops with items on mobile devices
                if (window.innerWidth <= 991.98) {
                    console.log('Mobile device detected, auto-opening shops with items');
                    
                    // Find all shops that have items (either unpurchased or purchased)
                    document.querySelectorAll('.shop-card-container').forEach(shopCard => {
                        const shopId = shopCard.dataset.shopId;
                        const collapseElement = document.getElementById(`collapse-${shopId}`);
                        const unpurchasedItems = shopCard.querySelectorAll('.draggable-item[data-purchased="false"]');
                        const purchasedItems = shopCard.querySelectorAll('.draggable-item[data-purchased="true"]');
                        const hasItems = unpurchasedItems.length > 0 || purchasedItems.length > 0;
                        
                        if (hasItems && !openShops.includes(shopId)) {
                            openShops.push(shopId);
                            console.log(`Auto-opening shop ${shopId} (${unpurchasedItems.length} unpurchased, ${purchasedItems.length} purchased items)`);
                        }
                    });
                }
                
                // Apply the open state to all shops in the openShops array
                const originalSavedShops = savedShops ? JSON.parse(savedShops) : [];
                
                openShops.forEach(shopId => {
                    const collapseElement = document.getElementById(`collapse-${shopId}`);
                    const headerElement = document.querySelector(`[data-bs-target="#collapse-${shopId}"]`);
                    
                    if (collapseElement && headerElement) {
                        // Add Bootstrap classes to show the collapse
                        collapseElement.classList.add('show');
                        
                        // Update aria-expanded attribute
                        headerElement.setAttribute('aria-expanded', 'true');
                        
                        // Rotate the chevron icon
                        const icon = headerElement.querySelector('.collapse-icon');
                        if (icon) {
                            icon.classList.add('rotated');
                        }
                        
                        // Add visual feedback based on how the list was opened
                        if (originalSavedShops.includes(shopId)) {
                            // This was a saved/restored list
                            headerElement.classList.add('restored');
                            setTimeout(() => {
                                headerElement.classList.remove('restored');
                            }, 2000);
                        } else {
                            // This was auto-opened because it has items
                            headerElement.classList.add('auto-opened');
                            collapseElement.classList.add('auto-opening');
                            setTimeout(() => {
                                headerElement.classList.remove('auto-opened');
                                collapseElement.classList.remove('auto-opening');
                            }, 3000);
                        }
                        
                        console.log(`Opened shop ${shopId}`);
                    }
                });
                
                // Show notification based on what was opened (only on initial page load)
                const isInitialLoad = !sessionStorage.getItem('yumsync_page_loaded');
                
                if (isInitialLoad) {
                    const savedCount = savedShops ? JSON.parse(savedShops).length : 0;
                    const autoOpenedCount = openShops.length - savedCount;
                    
                    if (savedCount > 0 && autoOpenedCount > 0) {
                        showAlert(`Restored ${savedCount} saved list${savedCount > 1 ? 's' : ''} and auto-opened ${autoOpenedCount} list${autoOpenedCount > 1 ? 's' : ''} with items`, 'info', 3000);
                    } else if (savedCount > 0) {
                        showAlert(`Restored ${savedCount} open shop list${savedCount > 1 ? 's' : ''}`, 'info', 2000);
                    } else if (autoOpenedCount > 0) {
                        showAlert(`Auto-opened ${autoOpenedCount} list${autoOpenedCount > 1 ? 's' : ''} with items`, 'info', 2000);
                    }
                    
                    // Mark that the page has been loaded
                    sessionStorage.setItem('yumsync_page_loaded', 'true');
                }
                
                // Update localStorage with the new state (including auto-opened shops)
                if (openShops.length > 0) {
                    localStorage.setItem('yumsync_open_shops', JSON.stringify(openShops));
                }
            }

            // Function to save state before page reload
            function saveStateBeforeReload() {
                saveCollapseState();
            }

            // Function to clear saved state (useful for manual refresh)
            function clearSavedState() {
                localStorage.removeItem('yumsync_open_shops');
                sessionStorage.removeItem('yumsync_page_loaded'); // Also clear the page loaded flag
                console.log('Cleared saved collapse state and page loaded flag');
            }

            // Listen for keyboard shortcuts to clear state
            document.addEventListener('keydown', function(e) {
                // Ctrl+Shift+R or Cmd+Shift+R to clear state and refresh
                if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'R') {
                    clearSavedState();
                }
            });

            // Handle window resize events (for device rotation or screen size changes)
            let resizeTimeout;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(function() {
                    console.log('Window resized, checking if mobile behavior should apply');
                    
                    // If we switched to mobile view, auto-open shops with items
                    if (window.innerWidth <= 991.98) {
                        const currentlyOpen = [];
                        document.querySelectorAll('.collapse.show').forEach(collapse => {
                            const shopId = collapse.id.replace('collapse-', '');
                            currentlyOpen.push(shopId);
                        });
                        
                        // Check if there are shops with items that aren't open
                        let newlyOpened = 0;
                        document.querySelectorAll('.shop-card-container').forEach(shopCard => {
                            const shopId = shopCard.dataset.shopId;
                            if (!currentlyOpen.includes(shopId)) {
                                const unpurchasedItems = shopCard.querySelectorAll('.draggable-item[data-purchased="false"]');
                                const purchasedItems = shopCard.querySelectorAll('.draggable-item[data-purchased="true"]');
                                const hasItems = unpurchasedItems.length > 0 || purchasedItems.length > 0;
                                
                                if (hasItems) {
                                    const collapseElement = document.getElementById(`collapse-${shopId}`);
                                    const headerElement = document.querySelector(`[data-bs-target="#collapse-${shopId}"]`);
                                    
                                    if (collapseElement && headerElement) {
                                        collapseElement.classList.add('show');
                                        headerElement.setAttribute('aria-expanded', 'true');
                                        
                                        const icon = headerElement.querySelector('.collapse-icon');
                                        if (icon) {
                                            icon.classList.add('rotated');
                                        }
                                        
                                        newlyOpened++;
                                        console.log(`Auto-opened shop ${shopId} after resize`);
                                    }
                                }
                            }
                        });
                        
                        if (newlyOpened > 0) {
                            showAlert(`Auto-opened ${newlyOpened} list${newlyOpened > 1 ? 's' : ''} with items`, 'info', 2000);
                            saveCollapseState(); // Save the new state
                        }
                    }
                }, 300); // Debounce resize events
            });

            // Listen for collapse events to save state in real-time
            document.addEventListener('shown.bs.collapse', function(e) {
                console.log('Collapse shown:', e.target.id);
                saveCollapseState();
            });

            document.addEventListener('hidden.bs.collapse', function(e) {
                console.log('Collapse hidden:', e.target.id);
                saveCollapseState();
            });

            // Also listen for manual chevron clicks to update icons
            document.addEventListener('click', function(e) {
                const mobileHeader = e.target.closest('.mobile-header');
                if (mobileHeader) {
                    const icon = mobileHeader.querySelector('.collapse-icon');
                    if (icon) {
                        // Toggle the rotation class
                        setTimeout(() => {
                            const targetCollapse = document.querySelector(mobileHeader.getAttribute('data-bs-target'));
                            if (targetCollapse) {
                                if (targetCollapse.classList.contains('show')) {
                                    icon.classList.add('rotated');
                                } else {
                                    icon.classList.remove('rotated');
                                }
                            }
                        }, 100);
                    }
                }
            });

            // Restore state when page loads
            restoreCollapseState();

            // When "Add Product" button is clicked, copy the input value to modal
            addProductBtn.addEventListener('click', function() {
                // Set to add mode
                isEditMode = false;
                editItemId.value = '';
                modalTitle.textContent = 'Add Product to List';
                addButtonText.textContent = 'Add to List';
                
                // Hide delete button in add mode
                deleteProductBtn.classList.add('d-none');

                const productName = productInput.value.trim();
                if (productName) {
                    newProductName.value = productName;
                } else {
                    newProductName.value = '';
                }
                // Reset form
                productAmount.value = 1;
                shopSelect.value = '';
            });

            // Decrease amount
            decreaseBtn.addEventListener('click', function() {
                let amount = parseInt(productAmount.value);
                if (amount > 1) {
                    productAmount.value = amount - 1;
                }
            });

            // Increase amount
            increaseBtn.addEventListener('click', function() {
                let amount = parseInt(productAmount.value);
                productAmount.value = amount + 1;
            });

            // Handle edit item buttons
            document.addEventListener('click', function(e) {
                if (e.target.closest('.edit-item-btn')) {
                    const button = e.target.closest('.edit-item-btn');
                    
                    // Set to edit mode
                    isEditMode = true;
                    editItemId.value = button.dataset.itemId;
                    modalTitle.textContent = 'Edit Product';
                    addButtonText.textContent = 'Update Product';
                    
                    // Show delete button in edit mode
                    deleteProductBtn.classList.remove('d-none');

                    // Populate form with existing data
                    newProductName.value = button.dataset.itemName;
                    productAmount.value = button.dataset.itemQuantity;
                    shopSelect.value = button.dataset.itemShopId;

                    // Clear the main input since we're editing from the modal
                    productInput.value = '';
                }
            });

            // Assign product to list - API call (handles both add and edit)
            assignProductBtn.addEventListener('click', async function() {
                const productName = newProductName.value.trim();
                const amount = parseInt(productAmount.value);
                const selectedShopId = parseInt(shopSelect.value);
                const itemId = editItemId.value;

                // Validation
                if (!productName) {
                    showAlert('Please enter a product name', 'warning');
                    return;
                }

                if (!selectedShopId) {
                    showAlert('Please select a shop', 'warning');
                    return;
                }

                // Show loading state
                setLoadingState(true);

                try {
                    let response, result;

                    if (isEditMode && itemId) {
                        // Edit existing product
                        response = await fetch(`/api/edit-product/${itemId}`, {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                productName: productName,
                                quantity: amount,
                                shopId: selectedShopId
                            })
                        });
                    } else {
                        // Add new product
                        response = await fetch('/api/add-product', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                productName: productName,
                                quantity: amount,
                                shopId: selectedShopId
                            })
                        });
                    }

                    result = await response.json();

                    console.log('API response:', result);

                    if (response.ok && result.success) {
                        if (isEditMode && itemId) {
                            console.log('Editing item:', itemId, 'with data:', result.listItem);
                            // Update existing item in UI
                            updateItemInUI(itemId, result.listItem);
                            showAlert(result.message, 'success');
                        } else {
                            console.log('Adding new item with data:', result.listItem);
                            console.log('Selected shop ID:', selectedShopId);
                            console.log('API returned shop ID:', result.listItem.shopId);
                            console.log('API returned shop name:', result.listItem.shopName);
                            
                            // Add new item to the UI
                            addItemToShopList(selectedShopId, result.listItem);
                            
                            // Verify the item was actually added to the DOM
                            setTimeout(() => {
                                const addedItem = document.querySelector(`[data-item-id="${result.listItem.id}"]`);
                                if (!addedItem) {
                                    console.warn('Item was not found in DOM after add attempt, refreshing page...');
                                    showAlert('Item added successfully! Refreshing to show changes...', 'info');
                                    location.reload();
                                } else {
                                    console.log('Item successfully added and found in DOM');
                                    showAlert(result.message, 'success');
                                }
                            }, 500);
                        }

                        // Clear inputs
                        productInput.value = '';
                        newProductName.value = '';
                        productAmount.value = 1;
                        shopSelect.value = '';
                        editItemId.value = '';
                        isEditMode = false;

                        // Reset modal title and button text
                        modalTitle.textContent = 'Add Product to List';
                        addButtonText.textContent = 'Add to List';
                        
                        // Hide delete button
                        deleteProductBtn.classList.add('d-none');

                        // Close modal
                        const modal = bootstrap.Modal.getInstance(document.getElementById('productModal'));
                        modal.hide();
                    } else {
                        showAlert(result.error || 'Failed to save product', 'danger');
                    }
                } catch (error) {
                    console.error('Error saving product:', error);
                    showAlert('Network error. Please try again.', 'danger');
                } finally {
                    setLoadingState(false);
                }
            });

            // Handle delete product button in modal
            deleteProductBtn.addEventListener('click', async function() {
                const itemId = editItemId.value;
                const productName = newProductName.value.trim();
                
                if (!itemId) {
                    showAlert('No product selected for deletion', 'warning');
                    return;
                }
                
                window.showConfirmation(
                    'Delete Product',
                    `Are you sure you want to delete "<strong>${productName}</strong>"?`,
                    async function() {
                        try {
                            const response = await fetch(`/api/remove-product/${itemId}`, {
                                method: 'DELETE'
                            });

                            const result = await response.json();
                            
                            console.log('Delete product API response:', result);

                            if (response.ok && result.success) {
                                // Clear form and close modal
                                productInput.value = '';
                            newProductName.value = '';
                            productAmount.value = 1;
                            shopSelect.value = '';
                            editItemId.value = '';
                            isEditMode = false;
                            
                            // Reset modal
                            modalTitle.textContent = 'Add Product to List';
                            addButtonText.textContent = 'Add to List';
                            deleteProductBtn.classList.add('d-none');
                            
                            // Close modal
                            const modal = bootstrap.Modal.getInstance(document.getElementById('productModal'));
                            modal.hide();
                            
                            // Remove item from UI
                            const listItem = document.querySelector(`[data-item-id="${itemId}"]`);
                            if (listItem) {
                                // Get the shop list before removing the item
                                const shopList = listItem.closest('.draggable-list');
                                const shopId = listItem.dataset.itemShopId;
                                
                                listItem.remove();
                                console.log('Item removed from DOM via modal delete');
                                
                                // Update shop item count
                                updateShopItemCount();
                            }
                            
                            showAlert(result.message, 'success');
                        } else {
                            showAlert(result.error || 'Failed to delete product', 'danger');
                        }
                        } catch (error) {
                            console.error('Error deleting product:', error);
                            showAlert('Network error. Please try again.', 'danger');
                        }
                    }
                );
            });            // Handle remove item buttons
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.remove-item-btn')) {
                    const button = e.target.closest('.remove-item-btn');
                    const itemId = button.dataset.itemId;
                    
                    console.log('Attempting to delete item with ID:', itemId);
                    
                    window.showConfirmation(
                        'Remove Item',
                        'Are you sure you want to permanently remove this item?',
                        async function() {
                            try {
                                const response = await fetch(`/api/remove-product/${itemId}`, {
                                    method: 'DELETE'
                                });

                                const result = await response.json();
                                
                                console.log('Delete API response:', result);

                                if (response.ok && result.success) {
                                    // Find and remove item from UI
                                    const listItem = document.querySelector(`[data-item-id="${itemId}"]`);
                                    
                                    console.log('Found list item to remove:', listItem);
                                
                                if (listItem) {
                                    // Get the shop list before removing the item
                                    const shopList = listItem.closest('.draggable-list');
                                    const shopId = listItem.dataset.itemShopId;
                                    
                                    listItem.remove();
                                    console.log('Item removed from DOM');
                                    
                                    // Check if this was the last item in the main list
                                    if (shopList && !shopList.dataset.purchasedSection) {
                                        const remainingItems = shopList.querySelectorAll('.draggable-item').length;
                                        console.log('Remaining items in shop list:', remainingItems);
                                        
                                        if (remainingItems === 0) {
                                            // This was the last item in main list, check if we should hide purchased section
                                            // Only hide if there are also no purchased items
                                            if (!shouldShowPurchasedSection(shopId)) {
                                                // No items in main list AND no purchased items, hide the purchased section
                                                hidePurchasedSectionForShop(shopId);
                                            }
                                        }
                                    }
                                    
                                    // Update shop item count (this will also handle empty state)
                                    updateShopItemCount();
                                    
                                    showAlert(result.message, 'success');
                                } else {
                                    console.error('Could not find list item with ID:', itemId);
                                    showAlert('Item removed from database but UI update failed. Please refresh.', 'warning');
                                }
                            } else {
                                showAlert(result.error || 'Failed to remove product', 'danger');
                            }
                        } catch (error) {
                            console.error('Error removing product:', error);
                            showAlert('Network error. Please try again.', 'danger');
                        }
                    }
                );
                }
            });

            // Handle mark as purchased buttons
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.mark-purchased-btn')) {
                    const button = e.target.closest('.mark-purchased-btn');
                    const itemId = button.dataset.itemId;
                    
                    console.log('Attempting to mark item as purchased with ID:', itemId);
                    
                    try {
                        const response = await fetch(`/api/mark-purchased/${itemId}`, {
                            method: 'PUT'
                        });

                        const result = await response.json();
                        
                        console.log('Mark purchased API response:', result);

                        if (response.ok && result.success) {
                            showAlert(result.message, 'success');
                            // Reload the page to reflect changes
                            window.location.reload();
                        } else {
                            showAlert(result.error || 'Failed to mark item as purchased', 'danger');
                        }
                    } catch (error) {
                        console.error('Error marking item as purchased:', error);
                        showAlert('Network error. Please try again.', 'danger');
                    }
                }
            });

            // Handle clicking on purchased items to unmark them
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.purchased-item-clickable')) {
                    const listItem = e.target.closest('.purchased-item-clickable');
                    const itemId = listItem.dataset.itemId;
                    
                    console.log('Attempting to unmark item as purchased with ID:', itemId);
                    
                    try {
                        const response = await fetch(`/api/unmark-purchased/${itemId}`, {
                            method: 'PUT'
                        });

                        const result = await response.json();
                        
                        console.log('Unmark purchased API response:', result);

                        if (response.ok && result.success) {
                            showAlert(result.message, 'success');
                            // Reload the page to reflect changes
                            window.location.reload();
                        } else {
                            showAlert(result.error || 'Failed to unmark item as purchased', 'danger');
                        }
                    } catch (error) {
                        console.error('Error unmarking item as purchased:', error);
                        showAlert('Network error. Please try again.', 'danger');
                    }
                }
            });

            // Handle delete all purchased items buttons
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.delete-purchased-btn')) {
                    const button = e.target.closest('.delete-purchased-btn');
                    const shopId = button.dataset.shopId;
                    
                    console.log('Attempting to delete all purchased items for shop ID:', shopId);
                    
                    window.showConfirmation(
                        'Delete All Purchased Items',
                        'Are you sure you want to permanently delete all purchased items for this shop?',
                        async function() {
                            try {
                                const response = await fetch(`/api/delete-purchased-items/${shopId}`, {
                                    method: 'DELETE'
                                });

                                const result = await response.json();
                            
                            console.log('Delete purchased items API response:', result);

                            if (response.ok && result.success) {
                                // Save collapse state before reload
                                saveStateBeforeReload();
                                
                                // Simply refresh the page to show the updated state
                                showAlert(result.message, 'success');
                                setTimeout(() => {
                                    window.location.reload();
                                }, 1000);
                            } else {
                                showAlert(result.error || 'Failed to delete purchased items', 'danger');
                            }
                        } catch (error) {
                            console.error('Error deleting purchased items:', error);
                            showAlert('Network error. Please try again.', 'danger');
                        }
                    }
                );
                }
            });

            // Handle revert all purchased items buttons
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.revert-all-btn')) {
                    const button = e.target.closest('.revert-all-btn');
                    const shopId = button.dataset.shopId;
                    
                    console.log('Attempting to revert all purchased items for shop ID:', shopId);
                    
                    window.showConfirmation(
                        'Revert All Items',
                        'Are you sure you want to move all purchased items back to the shopping list?',
                        async function() {
                            try {
                                const response = await fetch(`/api/revert-purchased-items/${shopId}`, {
                                    method: 'PUT'
                                });

                                const result = await response.json();
                                
                                console.log('Revert purchased items API response:', result);

                                if (response.ok && result.success) {
                                // Save collapse state before reload
                                saveStateBeforeReload();
                                
                                // Simply refresh the page to show the updated state
                                showAlert(result.message, 'success');
                                setTimeout(() => {
                                    window.location.reload();
                                }, 1000);
                            } else {
                                showAlert(result.error || 'Failed to revert purchased items', 'danger');
                            }
                        } catch (error) {
                            console.error('Error reverting purchased items:', error);
                            showAlert('Network error. Please try again.', 'danger');
                        }
                    }
                );
                }
            });

            // =========================
            // SHOP LISTS DRAG AND DROP FUNCTIONALITY
            // =========================
            
            let draggedShopCard = null;
            let shopListOrder = [];
            
            // Initialize shop list drag and drop and responsive behavior
            function initializeShopListFeatures() {
                // Check screen size and apply appropriate behavior
                if (window.innerWidth >= 992) {
                    // Desktop: Enable drag and drop
                    initializeShopListDragAndDrop();
                    loadShopListOrder();
                } else {
                    // Mobile/Tablet: Auto-sort by item count and setup collapse
                    autoSortShopListsByCount();
                    initializeMobileCollapse();
                }
            }
            
            // Desktop: Shop list drag and drop functionality
            function initializeShopListDragAndDrop() {
                const shopCards = document.querySelectorAll('.shop-card-container');
                const isMobile = window.innerWidth <= 991.98;
                
                shopCards.forEach(card => {
                    if (!isMobile) {
                        // Don't make the card draggable by default
                        card.setAttribute('draggable', 'false');
                        
                        // Add mousedown listener to drag handle to enable dragging
                        const dragHandle = card.querySelector('.drag-handle');
                        if (dragHandle) {
                            dragHandle.addEventListener('mousedown', function(e) {
                                // Enable dragging when mouse down on drag handle
                                card.setAttribute('draggable', 'true');
                                card.classList.add('header-dragging');
                            });
                            
                            dragHandle.addEventListener('mouseup', function(e) {
                                // Disable dragging when mouse up
                                setTimeout(() => {
                                    card.setAttribute('draggable', 'false');
                                    card.classList.remove('header-dragging');
                                }, 100);
                            });
                        }
                        
                        // Drag events
                        card.addEventListener('dragstart', handleShopDragStart);
                        card.addEventListener('dragend', handleShopDragEnd);
                        card.addEventListener('dragover', handleShopDragOver);
                        card.addEventListener('drop', handleShopDrop);
                        card.addEventListener('dragenter', handleShopDragEnter);
                        card.addEventListener('dragleave', handleShopDragLeave);
                    } else {
                        // On mobile, disable drag completely
                        card.setAttribute('draggable', 'false');
                        card.removeAttribute('draggable');
                    }
                });
                
                if (!isMobile) {
                    console.log('Shop list drag and drop initialized for desktop');
                } else {
                    console.log('Shop list drag and drop disabled for mobile');
                }
            }
            
            // Mobile/Tablet: Auto-sort by item count
            function autoSortShopListsByCount() {
                const container = document.getElementById('shopListsContainer');
                const shopCards = Array.from(container.querySelectorAll('.shop-card-container'));
                
                // Remove draggable attribute on mobile
                shopCards.forEach(card => {
                    card.removeAttribute('draggable');
                });
                
                // Sort by total item count (unpurchased + purchased)
                shopCards.sort((a, b) => {
                    const aCount = getTotalItemCount(a);
                    const bCount = getTotalItemCount(b);
                    return bCount - aCount; // Descending order (most items first)
                });
                
                // Add sorting animation class
                container.classList.add('sorting');
                
                // Reorder in DOM
                shopCards.forEach(card => {
                    container.appendChild(card);
                });
                
                // Remove sorting animation class after animation completes
                setTimeout(() => {
                    container.classList.remove('sorting');
                }, 500);
                
                console.log('Shop lists auto-sorted by item count for mobile/tablet');
            }
            
            // Get total item count for a shop card (unpurchased + purchased)
            function getTotalItemCount(shopCard) {
                const shopId = shopCard.dataset.shopId;
                const mainList = shopCard.querySelector(`#shoppingList-${shopId}`);
                const purchasedList = shopCard.querySelector(`[data-shop-id="${shopId}"][data-purchased-section="true"]`);
                
                const mainCount = mainList ? mainList.querySelectorAll('.draggable-item').length : 0;
                const purchasedCount = purchasedList ? purchasedList.querySelectorAll('.draggable-item').length : 0;
                
                return mainCount + purchasedCount;
            }
            
            // Mobile/Tablet: Initialize collapse functionality
            function initializeMobileCollapse() {
                const collapseHeaders = document.querySelectorAll('.mobile-header');
                
                collapseHeaders.forEach(header => {
                    header.addEventListener('click', function() {
                        const icon = this.querySelector('.collapse-icon');
                        const targetId = this.dataset.bsTarget;
                        const collapseElement = document.querySelector(targetId);
                        
                        // Toggle icon rotation
                        icon.classList.toggle('rotated');
                        
                        // Bootstrap collapse will handle the show/hide
                    });
                });
                
                console.log('Mobile collapse functionality initialized');
            }
            
            // Desktop: Shop drag event handlers
            function handleShopDragStart(e) {
                // Only allow dragging if it was initiated from the drag handle
                if (!e.currentTarget.classList.contains('header-dragging')) {
                    e.preventDefault();
                    return false;
                }
                
                draggedShopCard = e.currentTarget;
                draggedShopCard.classList.add('dragging');
                
                // Set drag data
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/html', draggedShopCard.outerHTML);
                
                console.log('Shop drag started:', draggedShopCard.dataset.shopName);
            }
            
            function handleShopDragEnd(e) {
                e.currentTarget.classList.remove('dragging');
                e.currentTarget.classList.remove('header-dragging');
                e.currentTarget.setAttribute('draggable', 'false');
                clearShopDragStyles();
                
                // Save the new order
                saveShopListOrder();
                
                draggedShopCard = null;
            }
            
            function handleShopDragEnter(e) {
                e.preventDefault();
                if (e.currentTarget !== draggedShopCard) {
                    e.currentTarget.classList.add('drag-over');
                }
            }
            
            function handleShopDragLeave(e) {
                if (!e.currentTarget.contains(e.relatedTarget)) {
                    e.currentTarget.classList.remove('drag-over');
                }
            }
            
            function handleShopDragOver(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
            }
            
            function handleShopDrop(e) {
                e.preventDefault();
                
                const dropTarget = e.currentTarget;
                if (dropTarget !== draggedShopCard && draggedShopCard) {
                    const container = dropTarget.parentNode;
                    const allCards = Array.from(container.children);
                    
                    const draggedIndex = allCards.indexOf(draggedShopCard);
                    const dropIndex = allCards.indexOf(dropTarget);
                    
                    if (draggedIndex < dropIndex) {
                        // Insert after drop target
                        container.insertBefore(draggedShopCard, dropTarget.nextSibling);
                    } else {
                        // Insert before drop target
                        container.insertBefore(draggedShopCard, dropTarget);
                    }
                    
                    console.log('Shop list reordered');
                }
                
                clearShopDragStyles();
            }
            
            function clearShopDragStyles() {
                document.querySelectorAll('.shop-card-container').forEach(card => {
                    card.classList.remove('drag-over');
                });
            }
            
            // Save shop list order to localStorage
            function saveShopListOrder() {
                const container = document.getElementById('shopListsContainer');
                const shopCards = container.querySelectorAll('.shop-card-container');
                const order = Array.from(shopCards).map(card => card.dataset.shopId);
                
                localStorage.setItem('yumsync_shop_order', JSON.stringify(order));
                console.log('Shop list order saved:', order);
            }
            
            // Load and apply saved shop list order
            function loadShopListOrder() {
                const savedOrder = localStorage.getItem('yumsync_shop_order');
                if (!savedOrder) return;
                
                try {
                    const order = JSON.parse(savedOrder);
                    const container = document.getElementById('shopListsContainer');
                    const shopCards = Array.from(container.querySelectorAll('.shop-card-container'));
                    
                    // Sort cards according to saved order
                    const sortedCards = [];
                    
                    // First, add cards in saved order
                    order.forEach(shopId => {
                        const card = shopCards.find(c => c.dataset.shopId === shopId);
                        if (card) {
                            sortedCards.push(card);
                        }
                    });
                    
                    // Then add any new cards that weren't in saved order
                    shopCards.forEach(card => {
                        if (!sortedCards.includes(card)) {
                            sortedCards.push(card);
                        }
                    });
                    
                    // Reorder in DOM
                    sortedCards.forEach(card => {
                        container.appendChild(card);
                    });
                    
                    console.log('Shop list order loaded and applied');
                } catch (error) {
                    console.error('Error loading shop list order:', error);
                }
            }
            
            // Handle window resize to switch between desktop and mobile behavior
            function handleResize() {
                // Debounce resize events
                clearTimeout(window.resizeTimeout);
                window.resizeTimeout = setTimeout(() => {
                    initializeShopListFeatures();
                }, 250);
            }
            
            // Initialize shop list features on page load
            initializeShopListFeatures();
            
            // Listen for window resize
            window.addEventListener('resize', handleResize);
            
            // Override updateShopItemCount to trigger re-sorting on mobile
            const originalUpdateShopItemCount = updateShopItemCount;
            updateShopItemCount = function() {
                originalUpdateShopItemCount();
                
                // Update item count badges
                document.querySelectorAll('.shop-card-container').forEach(card => {
                    const shopId = card.dataset.shopId;
                    const totalCount = getTotalItemCount(card);
                    const badge = card.querySelector('.item-count-badge');
                    if (badge) {
                        badge.textContent = `${totalCount} items`;
                    }
                });
                
                // Re-sort on mobile after item count changes
                if (window.innerWidth < 992) {
                    setTimeout(() => {
                        autoSortShopListsByCount();
                    }, 100);
                }
            };

            // Re-initialize drag and drop after dynamic content changes
            const originalAddItemToShopList = addItemToShopList;
            addItemToShopList = function(shopId, listItem) {
                originalAddItemToShopList(shopId, listItem);
                // Re-initialize drag and drop for new items
                setTimeout(() => {
                    initializeDragAndDrop();
                    // Re-initialize shop list features (this will trigger mobile re-sort)
                    initializeShopListFeatures();
                }, 100);
            };

