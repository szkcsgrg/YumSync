                    },
                    body: JSON.stringify({ userId: userId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    window.showAlert(`${username} has been removed from the household`, 'success');
                    await window.reloadHouseholdData(); // Reload all household data
                } else {
