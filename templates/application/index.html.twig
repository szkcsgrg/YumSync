            // =========================
            // DRAG AND DROP FUNCTIONALITY
            // =========================
            
            let draggedElement = null;
            let draggedElementData = null;
            let touchStartY = 0;
            let touchStartX = 0;
            let isDragging = false;
            let placeholder = null;

            // Initialize drag and drop
            function initializeDragAndDrop() {
                // Check if we're on mobile (touch device)
                const isMobile = window.innerWidth <= 991.98;
                
                // Add event listeners to all draggable items
                document.querySelectorAll('.draggable-item').forEach(item => {
                    if (!isMobile) {
                        // Desktop drag events only
                        item.addEventListener('dragstart', handleDragStart);
                        item.addEventListener('dragend', handleDragEnd);
                        
                        // Ensure draggable attribute is set on desktop
                        item.setAttribute('draggable', 'true');
                    } else {
                        // On mobile, disable drag completely
                        item.setAttribute('draggable', 'false');
                        item.removeAttribute('draggable');
                    }
                });

                if (!isMobile) {
                    // Add event listeners to all drop zones (including empty lists) - desktop only
                    document.querySelectorAll('.draggable-list').forEach(zone => {
                        zone.addEventListener('dragover', handleDragOver);
                        zone.addEventListener('drop', handleDrop);
                        zone.addEventListener('dragenter', handleDragEnter);
                        zone.addEventListener('dragleave', handleDragLeave);
                    });
                    
                    // Also add listeners to card bodies for empty shops - desktop only
                    document.querySelectorAll('.card-body').forEach(zone => {
                        zone.addEventListener('dragover', handleDragOver);
                        zone.addEventListener('drop', handleDrop);
                        zone.addEventListener('dragenter', handleDragEnter);
                        zone.addEventListener('dragleave', handleDragLeave);
                    });
                }
            }

            // Desktop Drag Events
            function handleDragStart(e) {
                // Prevent this drag event from propagating to parent shop card
                e.stopPropagation();
                
                // Ensure the parent shop card is not draggable when dragging list items
                const shopCard = e.target.closest('.shop-card-container');
                if (shopCard) {
                    shopCard.setAttribute('draggable', 'false');
                    shopCard.classList.remove('header-dragging');
                }
                
                draggedElement = e.target;
                draggedElementData = {
                    itemId: draggedElement.dataset.itemId,
                    itemName: draggedElement.dataset.itemName,
                    itemQuantity: draggedElement.dataset.itemQuantity,
                    currentShopId: draggedElement.dataset.itemShopId,
                    isPurchased: draggedElement.dataset.purchased === 'true'
                };
                
                draggedElement.classList.add('dragging');
                document.body.classList.add('dragging-active');
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/html', e.target.outerHTML);
                
                console.log('Drag started:', draggedElementData);
            }

            function handleDragEnd(e) {
                e.target.classList.remove('dragging');
                document.body.classList.remove('dragging-active');
                clearAllDragStyles();
                draggedElement = null;
                draggedElementData = null;
            }

            function handleDragEnter(e) {
                e.preventDefault();
                
                // Handle drop zones
                const list = e.target.closest('.draggable-list');
                const cardBody = e.target.closest('.card-body');
                
                if (list) {
                    list.classList.add('drag-over');
                } else if (cardBody && !cardBody.querySelector('.draggable-list')) {
                    // This is an empty card body, highlight the card
                    const card = cardBody.closest('.card');
                    if (card) {
                        card.classList.add('drag-target');
                    }
                }
            }

            function handleDragLeave(e) {
                // Only remove highlight if we're actually leaving the element
                if (!e.currentTarget.contains(e.relatedTarget)) {
                    if (e.target.classList.contains('draggable-list')) {
                        e.target.classList.remove('drag-over');
                    }
                    
                    const card = e.target.closest('.card');
                    if (card) {
                        card.classList.remove('drag-target');
                    }
                }
            }

            function handleDragOver(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                
                const list = e.target.closest('.draggable-list');
                const cardBody = e.target.closest('.card-body');
                
                if (list) {
                    // Clear any existing placeholders
                    removePlaceholder();
                    
                    // Add placeholder to show where the item will be dropped
                    const afterElement = getDragAfterElement(list, e.clientY);
                    if (afterElement == null) {
                        list.appendChild(createPlaceholder());
                    } else {
                        list.insertBefore(createPlaceholder(), afterElement);
                    }
                } else if (cardBody && !cardBody.querySelector('.draggable-list')) {
                    // This is an empty card, we can drop here
                    const card = cardBody.closest('.card');
                    if (card) {
                        card.classList.add('drag-target');
                    }
                }
            }

            function handleDrop(e) {
                e.preventDefault();
                
                let dropZone = e.target.closest('.draggable-list');
                let targetShopId = null;
                let isPurchasedSection = false;
                let insertPosition = null;
                
                if (dropZone) {
                    // Dropped on an existing list
                    targetShopId = dropZone.dataset.shopId;
                    isPurchasedSection = dropZone.dataset.purchasedSection === 'true';
                    
                    // Check if we need to handle reordering within the same list
                    if (parseInt(targetShopId) === parseInt(draggedElementData.currentShopId) && 
                        isPurchasedSection === draggedElementData.isPurchased) {
                        
                        // This is a reorder within the same list
                        console.log('Reordering within same list');
                        
                        // Find where to insert based on the placeholder position
                        const placeholder = dropZone.querySelector('.drag-placeholder');
                        if (placeholder) {
                            // Get all items in the list (excluding the dragged item and placeholder)
                            const allItems = [...dropZone.querySelectorAll('.draggable-item:not(.dragging)')];
                            insertPosition = allItems.findIndex(item => item.nextSibling === placeholder);
                            if (insertPosition === -1) {
                                insertPosition = allItems.length; // Insert at end
                            }
                            console.log('Insert position:', insertPosition);
                            
                            // Perform the reorder in the UI immediately
                            handleReorderInSameList(draggedElement, dropZone, placeholder);
                        }
                        
                        clearAllDragStyles();
                        removePlaceholder();
                        return; // Don't proceed with API calls for same-list reordering
                    }
                } else {
                    // Check if dropped on empty card body
                    const cardBody = e.target.closest('.card-body');
                    if (cardBody) {
                        const card = cardBody.closest('.card');
                        const shopHeader = card?.querySelector('.card-header h5');
                        
                        if (shopHeader) {
                            // Extract shop ID from existing lists in other cards or find by shop name
                            const allShopCards = document.querySelectorAll('.card');
                            for (const shopCard of allShopCards) {
                                if (shopCard === card) {
                                    // Find shop ID from header or existing list
                                    const existingList = shopCard.querySelector('[data-shop-id]');
                                    if (existingList) {
                                        targetShopId = existingList.dataset.shopId;
                                        break;
                                    } else {
                                        // This is an empty card, we need to get shop ID from other cards with same name
                                        const headerText = shopHeader.textContent.replace(/^\s*[^\w]*\s*/, '').trim();
                                        for (const otherCard of allShopCards) {
                                            const otherList = otherCard.querySelector('[data-shop-id]');
                                            const otherHeader = otherCard.querySelector('.card-header h5');
                                            if (otherList && otherHeader) {
                                                const otherHeaderText = otherHeader.textContent.replace(/^\s*[^\w]*\s*/, '').trim();
                                                if (otherHeaderText === headerText) {
                                                    targetShopId = otherList.dataset.shopId;
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                    break;
                                }
                            }
                        }
                    }
                }
                
                if (targetShopId && draggedElement && draggedElementData) {
                    console.log('Drop event:', {
                        targetShopId,
                        isPurchasedSection,
                        draggedData: draggedElementData
                    });
                    
                    // Handle the drop (shop or purchase status change)
                    handleItemMove(
                        draggedElementData.itemId,
                        targetShopId,
                        isPurchasedSection
                    );
                } else {
                    console.log('Drop failed - no valid target found');
                }
                
                clearAllDragStyles();
                removePlaceholder();
            }

            // Touch Events for Mobile
            function handleTouchStart(e) {
                if (e.target.closest('.btn') || e.target.closest('button')) return; // Don't drag buttons
                
                const touch = e.touches[0];
                touchStartY = touch.clientY;
                touchStartX = touch.clientX;
                isDragging = false;
                
                setTimeout(() => {
                    if (!isDragging) {
                        draggedElement = e.target.closest('.draggable-item');
                        if (draggedElement) {
                            draggedElementData = {
                                itemId: draggedElement.dataset.itemId,
                                itemName: draggedElement.dataset.itemName,
                                itemQuantity: draggedElement.dataset.itemQuantity,
                                currentShopId: draggedElement.dataset.itemShopId,
                                isPurchased: draggedElement.dataset.purchased === 'true'
                            };
                            draggedElement.classList.add('dragging');
                            document.body.classList.add('dragging-active');
                            isDragging = true;
                            console.log('Touch drag started:', draggedElementData);
                        }
                    }
                }, 200);
            }

            function handleTouchMove(e) {
                if (!isDragging || !draggedElement) return;
                
                e.preventDefault();
                const touch = e.touches[0];
                const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
                
                // Clear previous highlights
                clearAllDragStyles();
                
                // Find drop zone
                const dropList = elementBelow?.closest('.draggable-list');
                const cardBody = elementBelow?.closest('.card-body');
                
                if (dropList) {
                    dropList.classList.add('drag-over');
                } else if (cardBody && !cardBody.querySelector('.draggable-list')) {
                    const card = cardBody.closest('.card');
                    if (card) {
                        card.classList.add('drag-target');
                    }
                }
            }

            function handleTouchEnd(e) {
                if (!isDragging || !draggedElement) return;
                
                const touch = e.changedTouches[0];
                const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
                
                let targetShopId = null;
                let isPurchasedSection = false;
                
                // Find drop target
                const dropList = elementBelow?.closest('.draggable-list');
                if (dropList) {
                    targetShopId = dropList.dataset.shopId;
                    isPurchasedSection = dropList.dataset.purchasedSection === 'true';
                    
                    // Check if this is a reorder within the same list
                    if (parseInt(targetShopId) === parseInt(draggedElementData.currentShopId) && 
                        isPurchasedSection === draggedElementData.isPurchased) {
                        
                        console.log('Touch reordering within same list');
                        
                        // For touch, we'll insert based on the touch position
                        const dropListRect = dropList.getBoundingClientRect();
                        const touchY = touch.clientY - dropListRect.top;
                        
                        // Find the best insertion point
                        const allItems = [...dropList.querySelectorAll('.draggable-item:not(.dragging)')];
                        let insertBefore = null;
                        
                        for (const item of allItems) {
                            const itemRect = item.getBoundingClientRect();
                            const itemY = itemRect.top - dropListRect.top + itemRect.height / 2;
                            if (touchY < itemY) {
                                insertBefore = item;
                                break;
                            }
                        }
                        
                        // Perform the reorder
                        if (insertBefore) {
                            dropList.insertBefore(draggedElement, insertBefore);
                        } else {
                            dropList.appendChild(draggedElement);
                        }
                        
                        // Show visual feedback with CSS class
                        draggedElement.classList.add('just-moved');
                        
                        setTimeout(() => {
                            draggedElement.classList.remove('just-moved');
                        }, 600);
                        
                        // Reset states and return early
                        clearAllDragStyles();
                        document.body.classList.remove('dragging-active');
                        if (draggedElement) {
                            draggedElement.classList.remove('dragging');
                        }
                        draggedElement = null;
                        draggedElementData = null;
                        isDragging = false;
                        return;
                    }
                } else {
                    const cardBody = elementBelow?.closest('.card-body');
                    if (cardBody) {
                        const card = cardBody.closest('.card');
                        const existingList = card?.querySelector('[data-shop-id]');
                        if (existingList) {
                            targetShopId = existingList.dataset.shopId;
                        }
                    }
                }
                
                if (targetShopId && draggedElementData) {
                    console.log('Touch drop event:', {
                        targetShopId,
                        isPurchasedSection,
                        draggedData: draggedElementData
                    });
                    
                    // Handle the drop
                    handleItemMove(
                        draggedElementData.itemId,
                        targetShopId,
                        isPurchasedSection
                    );
                }
                
                // Reset states
                clearAllDragStyles();
                document.body.classList.remove('dragging-active');
                if (draggedElement) {
                    draggedElement.classList.remove('dragging');
                }
                draggedElement = null;
                draggedElementData = null;
                isDragging = false;
            }

            // Helper Functions
            function getDragAfterElement(container, y) {
                const draggableElements = [...container.querySelectorAll('.draggable-item:not(.dragging)')];
                
                return draggableElements.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;
                    
                    if (offset < 0 && offset > closest.offset) {
                        return { offset: offset, element: child };
                    } else {
                        return closest;
                    }
                }, { offset: Number.NEGATIVE_INFINITY }).element;
            }

            function createPlaceholder() {
                if (!placeholder) {
                    placeholder = document.createElement('div');
                    placeholder.className = 'drag-placeholder';
                }
                return placeholder;
            }

            function removePlaceholder() {
                if (placeholder && placeholder.parentNode) {
                    placeholder.parentNode.removeChild(placeholder);
                }
                placeholder = null;
            }

            function clearAllDragStyles() {
                document.querySelectorAll('.drag-over').forEach(el => {
                    el.classList.remove('drag-over');
                });
                document.querySelectorAll('.drag-target').forEach(el => {
                    el.classList.remove('drag-target');
                });
                removePlaceholder();
            }

            // Handle reordering within the same list
            function handleReorderInSameList(draggedElement, dropZone, placeholder) {
                console.log('Handling reorder in same list');
                
                // Remove the dragged element from its current position
                const originalParent = draggedElement.parentNode;
                const originalNextSibling = draggedElement.nextSibling;
                
                // Insert the element at the new position (where the placeholder is)
                if (placeholder && placeholder.parentNode) {
                    placeholder.parentNode.insertBefore(draggedElement, placeholder);
                    console.log('Element moved to new position');
                } else {
                    // If no placeholder, append to end
                    dropZone.appendChild(draggedElement);
                    console.log('Element moved to end of list');
                }
                
                // Show visual feedback with CSS class
                draggedElement.classList.add('just-moved');
                
                setTimeout(() => {
                    draggedElement.classList.remove('just-moved');
                }, 600);
                
                console.log('Reorder completed in UI');
            }

            // Handle item move between lists or within list
            async function handleItemMove(itemId, targetShopId, isPurchasedSection = false) {
                console.log('Moving item:', itemId, 'to shop:', targetShopId, 'purchased:', isPurchasedSection);
                
                try {
                    const response = await fetch('/api/move-item', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            itemId: itemId,
                            targetShopId: targetShopId,
                            isPurchased: isPurchasedSection
                        })
                    });

                    const result = await response.json();
                    
                    if (response.ok && result.success) {
                        console.log('Item moved successfully');
                        // Reload the page to reflect changes
                        window.location.reload();
                    } else {
                        console.error('Failed to move item:', result.message || 'Unknown error');
                        alert('Failed to move item: ' + (result.message || 'Unknown error'));
                    }
                } catch (error) {
                    console.error('Error moving item:', error);
                    alert('Error moving item: ' + error.message);
                }
            }

            // Initialize drag and drop when page loads
            initializeDragAndDrop();

            // =========================
            // SHOP LISTS DRAG AND DROP FUNCTIONALITY
            // =========================
            
            let draggedShopCard = null;
            let shopListOrder = [];
            
            // Initialize shop list drag and drop and responsive behavior
            function initializeShopListFeatures() {
                // Check screen size and apply appropriate behavior
                if (window.innerWidth >= 992) {
                    // Desktop: Enable drag and drop
                    initializeShopListDragAndDrop();
                    loadShopListOrder();
                } else {
                    // Mobile/Tablet: Auto-sort by item count and setup collapse
                    autoSortShopListsByCount();
                    initializeMobileCollapse();
                }
            }
            
            // Desktop: Shop list drag and drop functionality
            function initializeShopListDragAndDrop() {
                const shopCards = document.querySelectorAll('.shop-card-container');
                const isMobile = window.innerWidth <= 991.98;
                
                shopCards.forEach(card => {
                    if (!isMobile) {
                        // Don't make the card draggable by default
                        card.setAttribute('draggable', 'false');
                        
                        // Add mousedown listener to drag handle to enable dragging
                        const dragHandle = card.querySelector('.drag-handle');
                        if (dragHandle) {
                            dragHandle.addEventListener('mousedown', function(e) {
                                // Enable dragging when mouse down on drag handle
                                card.setAttribute('draggable', 'true');
                                card.classList.add('header-dragging');
                            });
                            
                            dragHandle.addEventListener('mouseup', function(e) {
                                // Disable dragging when mouse up
                                setTimeout(() => {
                                    card.setAttribute('draggable', 'false');
                                    card.classList.remove('header-dragging');
                                }, 100);
                            });
                        }
                        
                        // Drag events
                        card.addEventListener('dragstart', handleShopDragStart);
                        card.addEventListener('dragend', handleShopDragEnd);
                        card.addEventListener('dragover', handleShopDragOver);
                        card.addEventListener('drop', handleShopDrop);
                        card.addEventListener('dragenter', handleShopDragEnter);
                        card.addEventListener('dragleave', handleShopDragLeave);
                    } else {
                        // On mobile, disable drag completely
                        card.setAttribute('draggable', 'false');
                        card.removeAttribute('draggable');
                    }
                });
                
                if (!isMobile) {
                    console.log('Shop list drag and drop initialized for desktop');
                } else {
                    console.log('Shop list drag and drop disabled for mobile');
                }
            }
            
            // Mobile/Tablet: Auto-sort by item count
            function autoSortShopListsByCount() {
                const container = document.getElementById('shopListsContainer');
                const shopCards = Array.from(container.querySelectorAll('.shop-card-container'));
                
                // Remove draggable attribute on mobile
                shopCards.forEach(card => {
                    card.removeAttribute('draggable');
                });
                
                // Sort by total item count (unpurchased + purchased)
                shopCards.sort((a, b) => {
                    const aCount = getTotalItemCount(a);
                    const bCount = getTotalItemCount(b);
                    return bCount - aCount; // Descending order (most items first)
                });
                
                // Add sorting animation class
                container.classList.add('sorting');
                
                // Reorder in DOM
                shopCards.forEach(card => {
                    container.appendChild(card);
                });
                
                // Remove sorting animation class after animation completes
                setTimeout(() => {
                    container.classList.remove('sorting');
                }, 500);
                
                console.log('Shop lists auto-sorted by item count for mobile/tablet');
            }
            
            // Get total item count for a shop card (unpurchased + purchased)
            function getTotalItemCount(shopCard) {
                const shopId = shopCard.dataset.shopId;
                const mainList = shopCard.querySelector(`#shoppingList-${shopId}`);
                const purchasedList = shopCard.querySelector(`[data-shop-id="${shopId}"][data-purchased-section="true"]`);
                
                const mainCount = mainList ? mainList.querySelectorAll('.draggable-item').length : 0;
                const purchasedCount = purchasedList ? purchasedList.querySelectorAll('.draggable-item').length : 0;
                
                return mainCount + purchasedCount;
            }
            
            // Mobile/Tablet: Initialize collapse functionality
            function initializeMobileCollapse() {
                const collapseHeaders = document.querySelectorAll('.mobile-header');
                
                collapseHeaders.forEach(header => {
                    header.addEventListener('click', function() {
                        const icon = this.querySelector('.collapse-icon');
                        const targetId = this.dataset.bsTarget;
                        const collapseElement = document.querySelector(targetId);
                        
                        // Toggle icon rotation
                        icon.classList.toggle('rotated');
                        
                        // Bootstrap collapse will handle the show/hide
                    });
                });
                
                console.log('Mobile collapse functionality initialized');
            }
            
            // Desktop: Shop drag event handlers
            function handleShopDragStart(e) {
                // Only allow dragging if it was initiated from the drag handle
                if (!e.currentTarget.classList.contains('header-dragging')) {
                    e.preventDefault();
                    return false;
                }
                
                draggedShopCard = e.currentTarget;
                draggedShopCard.classList.add('dragging');
                
                // Set drag data
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/html', draggedShopCard.outerHTML);
                
                console.log('Shop drag started:', draggedShopCard.dataset.shopName);
            }
            
            function handleShopDragEnd(e) {
                e.currentTarget.classList.remove('dragging');
                e.currentTarget.classList.remove('header-dragging');
                e.currentTarget.setAttribute('draggable', 'false');
                clearShopDragStyles();
                
                // Save the new order
                saveShopListOrder();
                
                draggedShopCard = null;
            }
            
            function handleShopDragEnter(e) {
                e.preventDefault();
                if (e.currentTarget !== draggedShopCard) {
                    e.currentTarget.classList.add('drag-over');
                }
            }
            
            function handleShopDragLeave(e) {
                if (!e.currentTarget.contains(e.relatedTarget)) {
                    e.currentTarget.classList.remove('drag-over');
                }
            }
            
            function handleShopDragOver(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
            }
            
            function handleShopDrop(e) {
                e.preventDefault();
                
                const dropTarget = e.currentTarget;
                if (dropTarget !== draggedShopCard && draggedShopCard) {
                    const container = dropTarget.parentNode;
                    const allCards = Array.from(container.children);
                    
                    const draggedIndex = allCards.indexOf(draggedShopCard);
                    const dropIndex = allCards.indexOf(dropTarget);
                    
                    if (draggedIndex < dropIndex) {
                        // Insert after drop target
                        container.insertBefore(draggedShopCard, dropTarget.nextSibling);
                    } else {
                        // Insert before drop target
                        container.insertBefore(draggedShopCard, dropTarget);
                    }
                    
                    console.log('Shop list reordered');
                }
                
                clearShopDragStyles();
            }
            
            function clearShopDragStyles() {
                document.querySelectorAll('.shop-card-container').forEach(card => {
                    card.classList.remove('drag-over');
                });
            }
            
            // Save shop list order to localStorage
            function saveShopListOrder() {
                const container = document.getElementById('shopListsContainer');
                const shopCards = container.querySelectorAll('.shop-card-container');
                const order = Array.from(shopCards).map(card => card.dataset.shopId);
                
                localStorage.setItem('yumsync_shop_order', JSON.stringify(order));
                console.log('Shop list order saved:', order);
            }
            
            // Load and apply saved shop list order
            function loadShopListOrder() {
                const savedOrder = localStorage.getItem('yumsync_shop_order');
                if (!savedOrder) return;
                
                try {
                    const order = JSON.parse(savedOrder);
                    const container = document.getElementById('shopListsContainer');
                    const shopCards = Array.from(container.querySelectorAll('.shop-card-container'));
                    
                    // Sort cards according to saved order
                    const sortedCards = [];
                    
                    // First, add cards in saved order
                    order.forEach(shopId => {
                        const card = shopCards.find(c => c.dataset.shopId === shopId);
                        if (card) {
                            sortedCards.push(card);
                        }
                    });
                    
                    // Then add any new cards that weren't in saved order
                    shopCards.forEach(card => {
                        if (!sortedCards.includes(card)) {
                            sortedCards.push(card);
                        }
                    });
                    
                    // Reorder in DOM
                    sortedCards.forEach(card => {
                        container.appendChild(card);
                    });
                    
                    console.log('Shop list order loaded and applied');
                } catch (error) {
                    console.error('Error loading shop list order:', error);
                }
            }
            
            // Handle window resize to switch between desktop and mobile behavior
            function handleResize() {
                // Debounce resize events
                clearTimeout(window.resizeTimeout);
                window.resizeTimeout = setTimeout(() => {
                    initializeShopListFeatures();
                }, 250);
            }
            
            // Initialize shop list features on page load
            initializeShopListFeatures();
            
            // Listen for window resize
            window.addEventListener('resize', handleResize);
            
            // Override updateShopItemCount to trigger re-sorting on mobile
            const originalUpdateShopItemCount = updateShopItemCount;
            updateShopItemCount = function() {
                originalUpdateShopItemCount();
                
                // Update item count badges
                document.querySelectorAll('.shop-card-container').forEach(card => {
                    const shopId = card.dataset.shopId;
                    const totalCount = getTotalItemCount(card);
                    const badge = card.querySelector('.item-count-badge');
                    if (badge) {
                        badge.textContent = `${totalCount} items`;
                    }
                });
                
                // Re-sort on mobile after item count changes
                if (window.innerWidth < 992) {
                    setTimeout(() => {
                        autoSortShopListsByCount();
                    }, 100);
                }
            };

            // Re-initialize drag and drop after dynamic content changes
            const originalAddItemToShopList = addItemToShopList;
            addItemToShopList = function(shopId, listItem) {
                originalAddItemToShopList(shopId, listItem);
                // Re-initialize drag and drop for new items
                setTimeout(() => {
                    initializeDragAndDrop();
                    // Re-initialize shop list features (this will trigger mobile re-sort)
                    initializeShopListFeatures();
                }, 100);
            };

            // Helper function to add item to shop list in UI
            function addItemToShopList(shopId, listItem) {
                console.log('=== ADD ITEM TO SHOP LIST ===');
                console.log('Shop ID:', shopId);
                console.log('List Item:', listItem);
                
                let shopList = document.getElementById(`shoppingList-${shopId}`);
                console.log('Found existing shop list:', !!shopList);
                
                // If the shop list doesn't exist, we need to find the shop card by ID
                if (!shopList) {
                    console.log('No existing list found, looking for shop card by ID...');
                    
                    // First, try to find an existing list with this shop ID (even if it's hidden/empty)
                    const existingList = document.querySelector(`[id="shoppingList-${shopId}"]`);
                    if (existingList) {
                        console.log('Found existing list element by ID');
                        shopList = existingList;
                    } else {
                        console.log('No existing list found, looking through all shop cards...');
                        
                        // Look through all shop cards to find the one that should have this shop ID
                        const allShopCards = document.querySelectorAll('.col-md-6 .card');
                        console.log('Found', allShopCards.length, 'shop cards');
                        
                        let targetCard = null;
                        
                        allShopCards.forEach((card, index) => {
                            // Check if this card already has a list with any shop ID
                            const existingList = card.querySelector('[id^="shoppingList-"]');
                            if (existingList) {
                                const existingShopId = existingList.id.replace('shoppingList-', '');
                                console.log(`Card ${index}: has existing list for shop ID ${existingShopId}`);
                                if (existingShopId == shopId) {
                                    console.log(`Found matching card ${index} by existing list ID`);
                                    targetCard = card;
                                    shopList = existingList;
                                }
                            } else {
                                // This card might be empty - check if it's the right shop by looking at header
                                const header = card.querySelector('.card-header h5');
                                if (header) {
                                    const headerText = header.textContent;
                                    console.log(`Card ${index}: "${headerText}" (checking for empty card)`);
                                    
                                    // For empty cards, we need to match by shop name exactly
                                    if (listItem.shopName) {
                                        // Extract shop name from header (remove the icon)
                                        const shopNameInHeader = headerText.replace(/^\s*[^\w]*\s*/, '').trim();
                                        console.log(`Extracted shop name: "${shopNameInHeader}" vs target: "${listItem.shopName}"`);
                                        
                                        if (shopNameInHeader === listItem.shopName) {
                                            console.log(`Found matching empty card ${index} for shop: ${listItem.shopName}`);
                                            targetCard = card;
                                        }
                                    }
                                }
                            }
                        });
                        
                        if (targetCard && !shopList) {
                            console.log('Found target card, creating list structure...');
                            const cardBody = targetCard.querySelector('.card-body');
                            
                            // Remove empty state but keep it for later if needed
                            const emptyState = cardBody.querySelector('.empty-state');
                            if (emptyState) {
                                emptyState.remove();
                            }
                            
                            // Check if there's already a list
                            const existingList = cardBody.querySelector(`#shoppingList-${shopId}`);
                            if (existingList) {
                                existingList.classList.remove('d-none');
                                shopList = existingList;
                            } else {
                                // Create new list that's always visible
                                cardBody.innerHTML = `
                                    <ul class="list-group list-group-flush draggable-list" 
                                        id="shoppingList-${shopId}"
                                        data-shop-id="${shopId}"
                                        data-shop-name="${listItem.shopName}">
                                    </ul>
                                `;
                                shopList = document.getElementById(`shoppingList-${shopId}`);
                            }
                            console.log('Created new list, found:', !!shopList);
                        }
                    }
                }
                
                if (shopList) {
                    console.log('Adding item to shop list...');
                    const listElement = document.createElement('li');
                    listElement.className = 'list-group-item d-flex justify-content-between align-items-center draggable-item';
                    listElement.setAttribute('data-item-id', listItem.id);
                    listElement.setAttribute('data-item-name', listItem.productName);
                    listElement.setAttribute('data-item-quantity', listItem.quantity);
                    listElement.setAttribute('data-item-shop-id', shopId);
                    listElement.setAttribute('data-purchased', 'false');
                    listElement.setAttribute('draggable', 'true');
                    listElement.innerHTML = `
                        <div class="d-flex align-items-center">
                            <i class="fas fa-grip-vertical text-muted me-2"></i>
                            <span>${listItem.productName}</span>
                        </div>
                        <div>
                            <span class="badge bg-primary rounded-pill me-2">${listItem.quantity}</span>
                            <button class="btn btn-sm btn-outline-secondary me-1 edit-item-btn" 
                                    data-item-id="${listItem.id}"
                                    data-item-name="${listItem.productName}"
                                    data-item-quantity="${listItem.quantity}"
                                    data-item-shop-id="${shopId}"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#productModal"
                                    title="Edit item">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-success mark-purchased-btn" 
                                    data-item-id="${listItem.id}" 
                                    title="Mark as purchased">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    `;
                    shopList.appendChild(listElement);
                    console.log('Item added successfully!');
                    
                    // Check if this is the first item in the list and we need to show purchased section
                    const allItemsInList = shopList.querySelectorAll('.draggable-item').length;
                    console.log('Total items in list after adding:', allItemsInList);
                    
                    if (allItemsInList === 1) {
                        // This is the first item, we need to show the purchased section
                        // (since now we have at least one item in main list)
                        showPurchasedSectionForShop(shopId, shopList);
                    }
                    
                    // Update the item count
                    updateShopItemCount();
                    console.log('Item counts updated');
                } else {
                    console.error('Could not find or create shop list - will refresh page');
                    showAlert('Item added successfully! Refreshing page to show changes...', 'info');
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                }
                
                console.log('=== END ADD ITEM ===');
            }

            // Function to dynamically show purchased section when first item is added
            function showPurchasedSectionForShop(shopId, shopList) {
                console.log('Showing purchased section for shop:', shopId);
                
                const cardBody = shopList.closest('.card-body');
                if (!cardBody) return;
                
                // Check if purchased section already exists
                const existingPurchasedSection = cardBody.querySelector('[data-purchased-section="true"]');
                if (existingPurchasedSection) {
                    console.log('Purchased section already exists');
                    return;
                }
                
                // Find shop name from the list or card header
                let shopName = shopList.dataset.shopName;
                if (!shopName) {
                    const cardHeader = cardBody.closest('.card').querySelector('.card-header h5');
                    if (cardHeader) {
                        shopName = cardHeader.textContent.replace(/^\s*[^\w]*\s*/, '').trim();
                    }
                }
                
                // Create the purchased section HTML
                const purchasedSectionHTML = `
                    <hr class="my-3 purchased-section-transition showing">
                    <div class="d-flex justify-content-between align-items-center mb-3 purchased-section-transition showing">
                        <h6 class="text-muted mb-0">
                            <i class="fas fa-check-circle me-1"></i>Purchased Items (0)
                        </h6>
                    </div>
                    <ul class="list-group list-group-flush draggable-list purchased-section-transition showing" 
                        data-shop-id="${shopId}"
                        data-shop-name="${shopName}"
                        data-purchased-section="true">
                    </ul>
                `;
                
                // Add the purchased section after the main list
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = purchasedSectionHTML;
                
                // Insert all elements from tempDiv after the main shopping list
                while (tempDiv.firstChild) {
                    cardBody.appendChild(tempDiv.firstChild);
                }
                
                console.log('Purchased section added dynamically');
                
                // Re-initialize drag and drop for the new elements
                setTimeout(() => {
                    initializeDragAndDrop();
                }, 100);
            }

            // Function to hide purchased section when last item is removed
            function hidePurchasedSectionForShop(shopId) {
                console.log('Hiding purchased section for shop:', shopId);
                
                // Find the purchased section for this shop
                const purchasedSection = document.querySelector(`[data-shop-id="${shopId}"][data-purchased-section="true"]`);
                if (purchasedSection) {
                    const cardBody = purchasedSection.closest('.card-body');
                    
                    // Remove the purchased section and its header/separator
                    const hr = cardBody.querySelector('hr.my-3');
                    const header = cardBody.querySelector('.d-flex.justify-content-between.align-items-center.mb-3');
                    
                    if (hr) hr.remove();
                    if (header) header.remove();
                    purchasedSection.remove();
                    
                    console.log('Purchased section hidden');
                } else {
                    console.log('No purchased section found to hide');
                }
            }

            // Helper function to check if purchased section should be visible
            function shouldShowPurchasedSection(shopId) {
                const mainList = document.getElementById(`shoppingList-${shopId}`);
                const purchasedSection = document.querySelector(`[data-shop-id="${shopId}"][data-purchased-section="true"]`);
                
                const mainItems = mainList ? mainList.querySelectorAll('.draggable-item').length : 0;
                const purchasedItems = purchasedSection ? purchasedSection.querySelectorAll('.draggable-item').length : 0;
                
                console.log(`Shop ${shopId}: ${mainItems} main items, ${purchasedItems} purchased items`);
                return (mainItems > 0 || purchasedItems > 0);
            }

            // Helper function to update existing item in UI
            function updateItemInUI(itemId, listItem) {
                const listElement = document.querySelector(`[data-item-id="${itemId}"]`);
                if (listElement) {
                    // Get the current shop ID before making changes
                    const editButton = listElement.querySelector('.edit-item-btn');
                    const currentShopId = parseInt(editButton.getAttribute('data-item-shop-id'));
                    const newShopId = parseInt(listItem.shopId);
                    
                    console.log('Updating item:', itemId, 'from shop', currentShopId, 'to shop', newShopId);
                    
                    // If the shop changed, remove from current list and add to new one
                    if (currentShopId !== newShopId) {
                        console.log('Shop changed, moving item to new shop');
                        // Remove from current list
                        listElement.remove();
                        // Add to new shop list
                        addItemToShopList(newShopId, listItem);
                    } else {
                        console.log('Same shop, updating in place');
                        // Same shop, just update the content
                        const nameSpan = listElement.querySelector('.d-flex.align-items-center span');
                        const quantityBadge = listElement.querySelector('.badge.bg-primary');

                        if (nameSpan) {
                            nameSpan.textContent = listItem.productName;
                        }
                        if (quantityBadge) {
                            quantityBadge.textContent = listItem.quantity;
                        }
                        
                        // Update all data attributes on the list element itself
                        listElement.setAttribute('data-item-name', listItem.productName);
                        listElement.setAttribute('data-item-quantity', listItem.quantity);
                        listElement.setAttribute('data-item-shop-id', listItem.shopId);
                        
                        // Update edit button data attributes
                        editButton.setAttribute('data-item-name', listItem.productName);
                        editButton.setAttribute('data-item-quantity', listItem.quantity);
                        editButton.setAttribute('data-item-shop-id', listItem.shopId);
                        
                        console.log('Item updated in place successfully');
                    }
                }
                
                // Update shop item counts for all shops
                updateShopItemCount();
            }

            // Helper function to update shop item counts
            function updateShopItemCount() {
                console.log('Updating shop item counts');
                
                document.querySelectorAll('[id^="shoppingList-"]').forEach(list => {
                    const shopCard = list.closest('.card');
                    const countBadge = shopCard.querySelector('.badge.bg-secondary');
                    const itemCount = list.children.length;
                    
                    console.log('Shop list:', list.id, 'has', itemCount, 'items');
                    
                    if (countBadge) {
                        countBadge.textContent = `${itemCount} items`;
                    }
                    
                    // If the list is empty, show the empty state but keep the list visible for drop
                    if (itemCount === 0) {
                        console.log('Shop list is empty, showing empty state');
                        const cardBody = shopCard.querySelector('.card-body');
                        
                        // Keep the list visible for drop functionality
                        list.classList.remove('d-none');
                    } else {
                        // Just show the list without empty state
                        list.classList.remove('d-none');
                    }
                });
            }

            // Helper function to set loading state
            function setLoadingState(loading) {
                if (loading) {
                    addButtonText.classList.add('d-none');
                    addButtonSpinner.classList.remove('d-none');
                    assignProductBtn.disabled = true;
                } else {
                    addButtonText.classList.remove('d-none');
                    addButtonSpinner.classList.add('d-none');
                    assignProductBtn.disabled = false;
                }
            }

            // Helper function to show alerts
            function showAlert(message, type = 'info', timeout = 5000) {
                // Create alert element
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
                alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;

                // Add to page
                document.body.appendChild(alertDiv);

                // Auto remove after specified timeout
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, timeout);
            }
        });
    </script>
