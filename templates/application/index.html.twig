            if (!window.currentHousehold || window.currentHousehold.role !== 'owner') return;
            
            try {
                const timestamp = Date.now();
                const response = await fetch(`/api/household/pending-requests?_t=${timestamp}`);
                const result = await response.json();
                
                if (result.success) {
                    // Always call showPendingRequests, even if the array is empty
                    window.showPendingRequests(result.pendingRequests || []);
                } else {
                    // If there's an error, hide the section
                    window.showPendingRequests([]);
                }
            } catch (error) {
                console.error('Error loading pending requests:', error);
                // On error, hide the section
                window.showPendingRequests([]);
            }
        };

