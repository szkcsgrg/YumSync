        // =========================
        // DELETE HOUSEHOLD FUNCTIONALITY (OWNER ONLY)
        // =========================

        // Confirm household deletion with detailed warning
        window.confirmDeleteHousehold = function() {
            if (!window.currentHousehold || window.currentHousehold.role !== 'owner') {
                window.showAlert('Only household owners can delete households', 'danger');
                return;
            }

            const householdName = window.currentHousehold.name;
            const confirmMessage = `⚠️ PERMANENT DELETION WARNING ⚠️

Are you absolutely sure you want to delete "${householdName}"?

This action will PERMANENTLY:
• Delete ALL shopping lists and items
• Remove ALL household members  
• Delete the household completely
• This action CANNOT be undone`;

            window.showInputConfirmation(
                'Delete Household',
                confirmMessage,
                'DELETE',
                function() {
                    window.deleteHousehold();
                },
                function() {
                    window.showAlert('Household deletion cancelled.', 'info');
                }
            );
        };

        // Delete household - perform the actual deletion
        window.deleteHousehold = async function() {
            if (!window.currentHousehold || window.currentHousehold.role !== 'owner') {
                window.showAlert('Only household owners can delete households', 'danger');
                return;
            }

            try {
                // Show loading state
                const deleteButton = document.querySelector('button[onclick="confirmDeleteHousehold()"]');
                const originalText = deleteButton.innerHTML;
                deleteButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Deleting...';
                deleteButton.disabled = true;

                const response = await fetch('/api/household/delete', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();

                if (result.success) {
                    window.showAlert(`Household deleted successfully! Removed ${result.details.deletedItems} items and ${result.details.deletedMemberships} memberships.`, 'success');
                    
                    // Close the modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('householdModal'));
                    modal.hide();
                    
                    // Reload the page after a short delay to reflect changes
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    // Restore button state on error
                    deleteButton.innerHTML = originalText;
                    deleteButton.disabled = false;
                    window.showAlert(result.error || 'Failed to delete household', 'danger');
                }
            } catch (error) {
                console.error('Error deleting household:', error);
                
                // Restore button state on error
                const deleteButton = document.querySelector('button[onclick="confirmDeleteHousehold()"]');
                deleteButton.innerHTML = '<i class="fas fa-trash me-1"></i>Delete Household';
                deleteButton.disabled = false;
                
                window.showAlert('Network error. Please try again.', 'danger');
            }
        };

        // =========================
        // SHOP SETUP FUNCTIONALITY
        // =========================
        
        let shopsList = [];
        let hasDeletedShops = false; // Track if any shops were deleted

        // Initialize shop setup modal with existing shops
        function initializeShopSetup() {
            // Clear the shops list and reset deletion flag
            shopsList = [];
            hasDeletedShops = false;
            
            // Load existing shops if any
            const existingShops = {{ userShops|json_encode|raw }};
            
            if (existingShops && existingShops.length > 0) {
                existingShops.forEach(shop => {
                    // Add existing shops to the list
                    if (shop && shop.name) {
                        shopsList.push({
                            name: shop.name,
                            shopId: shop.shopId,
                            isExisting: true
                        });
                    }
                });
            }
            
            updateShopsDisplay();
        }

        // Listen for modal open event
        document.addEventListener('DOMContentLoaded', function() {
            const shopModal = document.getElementById('shopSetupModal');
            if (shopModal) {
                shopModal.addEventListener('show.bs.modal', function() {
                    initializeShopSetup();
                    updateRegionalShopsButton();
                });
            }
        });

        // Update the regional shops button text based on user location
        window.updateRegionalShopsButton = async function() {
            try {
                const response = await fetch('/api/location-shops', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();
                const button = document.getElementById('addSampleShopsBtn');
                const locationSpan = document.getElementById('currentLocation');
                
                if (result.success && result.location && result.location.country) {
                    button.innerHTML = `<i class="fas fa-magic me-1"></i>Add ${result.location.country} Shops`;
                    
                    // Update location display
                    let locationText = result.location.country;
                    if (result.location.region) {
                        locationText += `, ${result.location.region}`;
                    }
                    if (result.location.detectedFrom) {
                        locationText += ` (${result.location.detectedFrom === 'ip' ? 'auto-detected' : result.location.detectedFrom})`;
                    }
                    locationSpan.textContent = locationText;
                } else {
                    button.innerHTML = '<i class="fas fa-magic me-1"></i>Add Regional Shops';
                    locationSpan.textContent = 'Location not detected';
                }
            } catch (error) {
                console.error('Error updating button text:', error);
                document.getElementById('currentLocation').textContent = 'Location detection failed';
            }
        };

        // Toggle location settings form
        window.toggleLocationSettings = function() {
            const form = document.getElementById('locationSettingsForm');
            const isVisible = !form.classList.contains('d-none');
            
            if (isVisible) {
                form.classList.add('d-none');
            } else {
                form.classList.remove('d-none');
                // Load current location data into form if available
                loadCurrentLocationToForm();
            }
        };

        // Load current location data into the form
        window.loadCurrentLocationToForm = async function() {
            try {
                const response = await fetch('/api/location-shops', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();
                
                if (result.success && result.location) {
                    document.getElementById('countryCodeInput').value = result.location.countryCode || '';
                    document.getElementById('countryInput').value = result.location.country || '';
                    document.getElementById('regionInput').value = result.location.region || '';
                }
            } catch (error) {
                console.error('Error loading location data:', error);
            }
        };

        // Save location settings
        window.saveLocationSettings = async function() {
            try {
                const countryCode = document.getElementById('countryCodeInput').value.trim();
                const country = document.getElementById('countryInput').value.trim();
                const region = document.getElementById('regionInput').value.trim();

                if (!countryCode || !country) {
                    window.showAlert('Please enter both country code and country name', 'warning');
                    return;
                }

                const response = await fetch('/api/update-location', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        countryCode: countryCode.toUpperCase(),
                        country: country,
                        region: region
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    window.showAlert('Location updated successfully', 'success');
                    toggleLocationSettings();
                    updateRegionalShopsButton(); // Refresh the button and location display
                } else {
                    window.showAlert(result.error || 'Failed to update location', 'danger');
                }
            } catch (error) {
                console.error('Error saving location:', error);
                window.showAlert('Network error. Please try again.', 'danger');
            }
        };

        // Add shop to the temporary list
        window.addShopToList = function() {
            const shopNameInput = document.getElementById('newShopName');
            const shopName = shopNameInput.value.trim();
            
            if (!shopName) {
                window.showAlert('Please enter a shop name', 'warning');
                return;
            }
            
            // Check if shop already exists in the list
            // Add null/undefined checks to prevent TypeError
            if (shopsList.some(shop => shop && shop.name && shop.name.toLowerCase() === shopName.toLowerCase())) {
                window.showAlert('This shop is already in your list', 'warning');
                return;
            }
            
            // Add shop to temporary list
            shopsList.push({
                name: shopName,
                tempId: Date.now() // Temporary ID for UI purposes
            });
            
            // Clear input
            shopNameInput.value = '';
            
            // Update UI
            updateShopsDisplay();
            
            window.showAlert(`Added "${shopName}" to your shops list`, 'success');
        };

        // Update the shops display in the modal
        function updateShopsDisplay() {
            const noShopsMessage = document.getElementById('noShopsMessage');
            const shopsContainer = document.getElementById('shopsContainer');
            
            if (shopsList.length === 0) {
                noShopsMessage.classList.remove('d-none');
                shopsContainer.classList.add('d-none');
            } else {
                noShopsMessage.classList.add('d-none');
                shopsContainer.classList.remove('d-none');
                
                // Generate shops HTML
                shopsContainer.innerHTML = shopsList.map((shop, index) => `
                    <div class="d-flex justify-content-between align-items-center p-2 mb-2 rounded border">
                        <div class="d-flex align-items-center flex-grow-1">
                            <i class="fas fa-store text-primary me-2"></i>
                            <span>${shop.name}</span>
                            ${shop.isExisting ? '<span class="badge bg-secondary ms-2">Existing</span>' : '<span class="badge bg-success ms-2">New</span>'}
                        </div>
                        <div class="shop-remove-btn-container">
                            <button class="btn btn-sm btn-outline-danger shop-remove-btn" 
                                    data-shop-id="${shop.shopId || ''}" 
                                    data-shop-name="${shop.name}" 
                                    data-shop-index="${index}" 
                                    data-is-existing="${shop.isExisting ? 'true' : 'false'}"
                                    title="Remove shop"
                                    type="button">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
                
                // Add event listeners for remove buttons (enhanced mobile support)
                const removeButtons = shopsContainer.querySelectorAll('.shop-remove-btn');
                removeButtons.forEach(button => {
                    // Remove any existing listeners
                    button.replaceWith(button.cloneNode(true));
                });
                
                // Re-query after replacing
                const newRemoveButtons = shopsContainer.querySelectorAll('.shop-remove-btn');
                newRemoveButtons.forEach(button => {
                    console.log('Adding event listeners to shop remove button');
                    
                    // Simple, reliable approach for mobile
                    let isProcessing = false;
                    
                    // Function to handle removal
                    const handleRemoval = function() {
                        if (isProcessing) return;
                        isProcessing = true;
                        
                        console.log('Shop remove button activated');
                        
                        const shopId = this.dataset.shopId;
                        const shopName = this.dataset.shopName;
                        const shopIndex = parseInt(this.dataset.shopIndex);
                        const isExisting = this.dataset.isExisting === 'true';
                        
                        console.log('Shop data:', { shopId, shopName, shopIndex, isExisting });
                        
                        // Add visual feedback
                        this.style.backgroundColor = '#dc3545';
                        this.style.color = 'white';
                        this.style.border = '1px solid #dc3545';
                        
                        // Execute removal
                        if (isExisting) {
                            window.removeExistingShop(parseInt(shopId), shopName, shopIndex);
                        } else {
                            window.removeShopFromList(shopIndex);
                        }
                        
                        // Reset processing flag after a delay
                        setTimeout(() => {
                            isProcessing = false;
                        }, 500);
                    };
                    
                    // Use both click and touchstart for maximum compatibility
                    button.addEventListener('click', function(e) {
                        e.stopPropagation();
                        console.log('Button clicked');
                        handleRemoval.call(this);
                    });
                    
                    // Add touchstart as backup for mobile
                    button.addEventListener('touchstart', function(e) {
                        e.stopPropagation();
                        console.log('Button touched');
                        
                        // Visual feedback on touch
                        this.style.backgroundColor = '#dc3545';
                        this.style.color = 'white';
                        this.style.transform = 'scale(0.95)';
                        
                        // Trigger action immediately on touch
                        setTimeout(() => {
                            handleRemoval.call(this);
                            this.style.transform = 'scale(1)';
                        }, 100);
                    });
                });
            }
            
            updateSaveButtonState();
        }

        // Update the save button state based on changes
        function updateSaveButtonState() {
            const saveBtn = document.getElementById('saveShopsBtn');
            const saveText = document.getElementById('saveShopsText');
            const newShops = shopsList.filter(shop => !shop.isExisting);
            const hasChanges = newShops.length > 0 || hasDeletedShops;
            
            if (hasChanges) {
                saveBtn.disabled = false;
                if (newShops.length > 0 && hasDeletedShops) {
                    saveText.textContent = 'Save Changes';
                } else if (newShops.length > 0) {
                    saveText.textContent = 'Save New Shops';
                } else if (hasDeletedShops) {
                    saveText.textContent = 'Apply Changes';
                }
            } else {
                saveBtn.disabled = true;
                saveText.textContent = 'Save Shops';
            }
        }

        // Remove shop from temporary list
        window.removeShopFromList = function(index) {
            console.log('removeShopFromList called with index:', index);
            const removedShop = shopsList.splice(index, 1)[0];
            updateShopsDisplay();
            console.log('Calling showAlert for removed shop:', removedShop.name);
            window.showAlert(`Removed "${removedShop.name}" from your shops list`, 'info');
        };

        // Remove existing shop from database and UI
        window.removeExistingShop = async function(shopId, shopName, index) {
            console.log('removeExistingShop called:', { shopId, shopName, index });
            
            // Use mobile-friendly confirmation
            window.showConfirmation(
                'Delete Shop',
                `Are you sure you want to delete "<strong>${shopName}</strong>"?<br><br><small class="text-warning">This will remove all shopping list items from this shop as well.</small>`,
                async function() {
                    console.log('User confirmed shop deletion, proceeding...');

                    try {
                        const response = await fetch('/api/remove-shop', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                shopId: shopId
                            })
                        });

                        const result = await response.json();
                        console.log('Shop deletion API response:', result);

                        if (response.ok && result.success) {
                            // Remove from the UI list
                            shopsList.splice(index, 1);
                            hasDeletedShops = true; // Mark that shops were deleted
                            updateShopsDisplay();
                            console.log('Calling showAlert for successful deletion');
                            window.showAlert(`"${shopName}" has been deleted successfully`, 'success');
                        } else {
                            console.log('Shop deletion failed:', result.error);
                            window.showAlert(result.error || 'Failed to delete shop', 'danger');
                        }
                    } catch (error) {
                        console.error('Error deleting shop:', error);
                        window.showAlert('Network error. Please try again.', 'danger');
                    }
                },
                function() {
                    console.log('User cancelled shop deletion');
                }
            );
        };

        // Add location-based sample shops for quick setup
        window.addSampleShops = async function() {
            try {
                // Show loading state
                const button = document.querySelector('button[onclick="addSampleShops()"]');
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Loading suggestions...';
                button.disabled = true;

                const response = await fetch('/api/location-shops', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();

                // Restore button state
                button.innerHTML = originalText;
                button.disabled = false;

                if (result.success && result.suggestedShops && result.suggestedShops.length > 0) {
                    let addedShops = 0;
                    
                    // Add first 8-10 suggested shops to avoid overwhelming the user
                    const shopsToAdd = result.suggestedShops.slice(0, 10);
                    
                    shopsToAdd.forEach(shopName => {
                        if (!shopsList.some(shop => shop && shop.name && shop.name.toLowerCase() === shopName.toLowerCase())) {
                            shopsList.push({
                                name: shopName,
                                tempId: Date.now() + Math.random()
                            });
                            addedShops++;
                        }
                    });
                    
                    updateShopsDisplay();
                    
                    if (addedShops > 0) {
                        const locationInfo = result.location && result.location.country 
                            ? ` for ${result.location.country}` 
                            : '';
                        window.showAlert(`Added ${addedShops} popular shops${locationInfo} to your list`, 'success');
                    } else {
                        window.showAlert('All suggested shops are already in your list', 'info');
                    }
                } else {
                    // Fallback to generic shops if location detection failed
                    const fallbackShops = ['Local Supermarket', 'Grocery Store', 'Corner Shop', 'Market', 'Food Store'];
                    let addedShops = 0;
                    
                    fallbackShops.forEach(shopName => {
                        if (!shopsList.some(shop => shop && shop.name && shop.name.toLowerCase() === shopName.toLowerCase())) {
                            shopsList.push({
                                name: shopName,
                                tempId: Date.now() + Math.random()
                            });
                            addedShops++;
                        }
                    });
                    
                    updateShopsDisplay();
                    window.showAlert(`Added ${addedShops} generic shops to your list`, 'success');
                }
            } catch (error) {
                console.error('Error loading shop suggestions:', error);
                
                // Restore button state
                const button = document.querySelector('button[onclick="addSampleShops()"]');
                button.innerHTML = '<i class="fas fa-magic me-1"></i>Add Sample Shops';
                button.disabled = false;
                
                // Fallback to basic shops on error
                const basicShops = ['Supermarket', 'Grocery Store', 'Market'];
                basicShops.forEach(shopName => {
                    if (!shopsList.some(shop => shop && shop.name && shop.name.toLowerCase() === shopName.toLowerCase())) {
                        shopsList.push({
                            name: shopName,
                            tempId: Date.now() + Math.random()
                        });
                    }
                });
                
                updateShopsDisplay();
                window.showAlert('Added basic shops to your list', 'warning');
            }
        };

        // Save shops to database
        window.saveShops = async function() {
            const newShops = shopsList.filter(shop => !shop.isExisting);
            
            // Check if there are new shops to save or if shops were deleted
            if (newShops.length === 0 && !hasDeletedShops) {
                window.showAlert('No changes to save', 'info');
                return;
            }
            
            // If only deletions occurred (no new shops), just close modal and refresh
            if (newShops.length === 0 && hasDeletedShops) {
                window.showAlert('Changes saved successfully!', 'success');
                
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('shopSetupModal'));
                modal.hide();
                
                // Reload page to show changes
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
                return;
            }
            
            // Show loading state
            const saveBtn = document.getElementById('saveShopsBtn');
            const saveText = document.getElementById('saveShopsText');
            const saveSpinner = document.getElementById('saveShopsSpinner');
            
            saveBtn.disabled = true;
            saveText.classList.add('d-none');
            saveSpinner.classList.remove('d-none');
            
            try {
                const response = await fetch('/application/setup-shops', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        shops: newShops.map(shop => shop.name)
                    })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    const totalChanges = newShops.length + (hasDeletedShops ? 1 : 0);
                    let message = 'Changes saved successfully!';
                    
                    if (newShops.length > 0 && hasDeletedShops) {
                        message = `Added ${newShops.length} new shops and removed deleted shops!`;
                    } else if (newShops.length > 0) {
                        message = `Successfully added ${newShops.length} new shops!`;
                    }
                    
                    window.showAlert(message, 'success');
                    
                    // Clear the shops list and reset flags
                    shopsList = [];
                    hasDeletedShops = false;
                    
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('shopSetupModal'));
                    modal.hide();
                    
                    // Reload page to show new shops
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    window.showAlert(result.error || 'Failed to save shops', 'danger');
                }
            } catch (error) {
                console.error('Error saving shops:', error);
                window.showAlert('Network error. Please try again.', 'danger');
            } finally {
                // Reset loading state
                saveBtn.disabled = false;
                saveText.classList.remove('d-none');
                saveSpinner.classList.add('d-none');
            }
        };

        // Handle Enter key in shop name input
        document.addEventListener('DOMContentLoaded', function() {
            const shopNameInput = document.getElementById('newShopName');
            if (shopNameInput) {
                shopNameInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        window.addShopToList();
                    }
                });
            }
        });

        // =========================
        // PROFILE MANAGEMENT
        // =========================
        
        // Function to confirm profile deletion
        window.confirmDeleteProfile = function() {
            const confirmationText = 'DELETE MY ACCOUNT';
            const warningMessage = `⚠️ FINAL WARNING ⚠️

This will permanently delete your entire account and all associated data.`;

            window.showInputConfirmation(
                'Delete Account',
                warningMessage,
                confirmationText,
                function() {
                    window.deleteUserProfile();
                },
                function() {
                    showAlert('Account deletion cancelled.', 'info');
                }
            );
        };
        
        // Function to delete user profile
        window.deleteUserProfile = async function() {
            try {
                showAlert('Deleting account... This may take a moment.', 'warning', 0);
                
                const response = await fetch('/api/profile/delete', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const result = await response.json();
                
                if (response.ok && result.success) {
                    // Show success message
                    showAlert(result.message, 'success', 3000);
                    
                    // Log deletion details if available
                    if (result.details) {
                        console.log('Profile deletion completed:', result.details);
                    }
                    
                    // Close any open modals
                    const profileModal = bootstrap.Modal.getInstance(document.getElementById('profileModal'));
                    if (profileModal) {
                        profileModal.hide();
                    }
                    
                    // Force redirect to farewell page immediately
                    setTimeout(() => {
                        window.location.replace(result.redirect || '/farewell');
                    }, 1500);
                    
                } else {
                    showAlert(result.error || 'Failed to delete account', 'danger');
                }
            } catch (error) {
                console.error('Error deleting profile:', error);
                
                // Even if there's a network error, still try to redirect after showing error
                showAlert('Account deletion may have completed. Redirecting...', 'warning');
                setTimeout(() => {
                    window.location.replace('/farewell');
                }, 2000);
            }
        };
    </script>
    
