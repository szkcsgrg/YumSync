                                Role: ${member.role} | 
                                Joined: ${new Date(member.joinedAt).toLocaleDateString()}
                            </small>
                        </div>
                        <div>
                            ${removeButtonHtml}
                        </div>
                    </div>
                `;
                container.appendChild(memberElement);
            });
        };

        // Remove a member from household (for owners)
        window.removeMember = async function(userId, username) {
            window.showConfirmation(
                'Remove Member',
                `Are you sure you want to remove <strong>${username}</strong> from the household?`,
