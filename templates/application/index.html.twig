        // Mobile-friendly text input confirmation function
        window.showInputConfirmation = function(title, message, requiredText, onConfirm, onCancel = null) {
            const inputConfirmHtml = `
                <div class="modal fade" id="mobileInputConfirmModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
